<file path="tests/naming.test.ts">
import { ok, rejects, strictEqual } from 'node:assert/strict'
import { mkdir, mkdtemp, readFile, rm, stat, writeFile } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import { basename, join } from 'node:path'
import { after, before, describe, it } from 'node:test'
import {
  copyAcrossVolumes,
  decodeHeaderText,
  discardReservedPath,
  extensionOf,
  filenameFromDisposition,
  filenameFromUrl,
  moveFile,
  sanitizeFilename,
  uniquePath
} from '../src/main/engine/naming.ts'

/**
 * Names are where a download meets the filesystem, and every rule here exists
 * because some server or some OS quirk broke a download that had already
 * finished transferring.
 */

let dir = ''

before(async () => {
  dir = await mkdtemp(join(tmpdir(), 'draco-naming-'))
})

after(async () => {
  await rm(dir, { recursive: true, force: true })
})

describe('sanitizeFilename', () => {
  it('strips the characters NTFS refuses', () => {
    strictEqual(sanitizeFilename('a<b>c:d"e/f\\g|h?i*j.txt'), 'abcdefghij.txt')
  })

  it('drops control characters, which are written by escape so this file stays text', () => {
    const bell = String.fromCodePoint(7)
    strictEqual(sanitizeFilename(`clip${bell} recording.mp4`), 'clip recording.mp4')
    strictEqual(sanitizeFilename(`a${String.fromCodePoint(0)}b.txt`), 'ab.txt')
  })

  it('drops format characters such as the right-to-left override, and DEL/C1 controls', () => {
    const rlo = String.fromCodePoint(0x202e)
    strictEqual(sanitizeFilename(`invoice${rlo}fdp.exe`), 'invoicefdp.exe')
    strictEqual(sanitizeFilename(`a${String.fromCodePoint(0x200b)}b.txt`), 'ab.txt')
    strictEqual(sanitizeFilename(`a${String.fromCodePoint(0x7f)}b${String.fromCodePoint(0x9f)}c.txt`), 'abc.txt')
  })

  it('escapes reserved device names, which fail at open() rather than at write', () => {
    strictEqual(sanitizeFilename('CON'), 'CON_')
    strictEqual(sanitizeFilename('com4.txt'), 'com4_.txt')
    strictEqual(sanitizeFilename('console.txt'), 'console.txt', 'only the exact names are reserved')
    strictEqual(sanitizeFilename('CON.tar.gz'), 'CON_.tar.gz')
    strictEqual(sanitizeFilename('COM¹.mp4'), 'COM¹_.mp4')
    strictEqual(sanitizeFilename('lpt².backup.zip'), 'lpt²_.backup.zip')
  })

  it('removes the trailing dots and spaces Windows would silently eat', () => {
    // Left in place, the file we create and the file we look for disagree.
    strictEqual(sanitizeFilename('report...'), 'report')
    strictEqual(sanitizeFilename('report   '), 'report')
  })

  it('caps the stem, never the extension', () => {
    const long = sanitizeFilename('x'.repeat(400) + '.mkv')
    ok(long.endsWith('.mkv'), 'a long title must not eat the extension')
    strictEqual(long.length, 154)
  })

  it('falls back when nothing usable is left', () => {
    strictEqual(sanitizeFilename('///'), 'download')
    strictEqual(sanitizeFilename('   ', 'fallback.bin'), 'fallback.bin')
  })

  it('keeps non-ASCII names intact', () => {
    strictEqual(sanitizeFilename('Böhmische Träume.flac'), 'Böhmische Träume.flac')
    strictEqual(sanitizeFilename('東京.mp4'), '東京.mp4')
  })
})

describe('extensionOf', () => {
  it('lowercases and drops the dot', () => {
    strictEqual(extensionOf('Movie.MKV'), 'mkv')
    strictEqual(extensionOf('archive.tar.gz'), 'gz')
    strictEqual(extensionOf('README'), '')
  })
})

describe('filenameFromDisposition', () => {
  it('prefers RFC 5987 over the plain form', () => {
    const header = `attachment; filename="fallback.txt"; filename*=UTF-8''%E6%97%A5%E6%9C%AC.txt`
    strictEqual(filenameFromDisposition(header), '日本.txt')
  })

  it('falls back to the plain form when the extended one is malformed', () => {
    const header = `attachment; filename="good.txt"; filename*=UTF-8''%E6%9`
    strictEqual(filenameFromDisposition(header), 'good.txt')
  })

  it('reads quoted and bare values', () => {
    strictEqual(filenameFromDisposition('attachment; filename="my file.zip"'), 'my file.zip')
    strictEqual(filenameFromDisposition('attachment; filename=plain.zip'), 'plain.zip')
    strictEqual(filenameFromDisposition('attachment'), null)
    strictEqual(filenameFromDisposition(undefined), null)
  })
})

describe('decodeHeaderText', () => {
  it('repairs UTF-8 bytes that were decoded as Latin-1', () => {
    // What a server sends as UTF-8 arrives one JS character per byte.
    const misread = Buffer.from('日本.txt', 'utf8').toString('latin1')
    strictEqual(decodeHeaderText(misread), '日本.txt')
  })

  it('leaves a genuinely Latin-1 name alone', () => {
    strictEqual(decodeHeaderText('Grüße.txt'), 'Grüße.txt')
  })

  it('leaves plain ASCII and real Unicode alone', () => {
    strictEqual(decodeHeaderText('plain.txt'), 'plain.txt')
    strictEqual(decodeHeaderText('日本.txt'), '日本.txt')
  })
})

describe('filenameFromUrl', () => {
  it('takes the last segment, percent-decoded, without query or fragment', () => {
    strictEqual(filenameFromUrl('https://example.test/a/b/my%20file.zip?token=1#frag'), 'my file.zip')
    strictEqual(filenameFromUrl('https://example.test/'), null)
    strictEqual(filenameFromUrl('not a url'), null)
  })

  it('survives a broken percent-escape', () => {
    strictEqual(filenameFromUrl('https://example.test/bad%zz.bin'), 'bad%zz.bin')
  })
})

describe('uniquePath', () => {
  it('fails when it cannot reserve a name', async () => {
    await rejects(uniquePath(join(dir, 'missing-directory'), 'clip.mp4'), { code: 'ENOENT' })
  })

  it('reserves the name it returns, so two downloads cannot be handed the same one', async () => {
    const first = await uniquePath(dir, 'clip.mp4')
    strictEqual(basename(first), 'clip.mp4')
    strictEqual((await stat(first)).size, 0, 'the reservation is an empty placeholder')

    const second = await uniquePath(dir, 'clip.mp4')
    strictEqual(basename(second), 'clip (1).mp4')

    const third = await uniquePath(dir, 'clip.mp4')
    strictEqual(basename(third), 'clip (2).mp4')
  })

  it('numbers before the extension, and handles names without one', async () => {
    await uniquePath(dir, 'notes')
    strictEqual(basename(await uniquePath(dir, 'notes')), 'notes (1)')
  })

  it('hands back a name it reserved but nothing was written to', async () => {
    const reserved = await uniquePath(dir, 'abandoned.bin')
    await discardReservedPath(reserved)
    strictEqual(basename(await uniquePath(dir, 'abandoned.bin')), 'abandoned.bin', 'the good name is free again')
  })

  it('never deletes a file that has content', async () => {
    const real = join(dir, 'finished.bin')
    await writeFile(real, 'data', 'utf8')
    await discardReservedPath(real)
    strictEqual((await readFile(real, 'utf8')), 'data')
  })

  it('discards a stranded 0-byte reservation before reserving so retries get the original name', async () => {
    const stranded = await uniquePath(dir, 'dash-crash.mp4')
    strictEqual(basename(stranded), 'dash-crash.mp4')
    await discardReservedPath(join(dir, 'dash-crash.mp4'))
    const retry = await uniquePath(dir, 'dash-crash.mp4')
    strictEqual(basename(retry), 'dash-crash.mp4')
    await discardReservedPath(retry)
  })
})

describe('moveFile', () => {
  it('moves within a volume and leaves nothing behind', async () => {
    const src = join(dir, 'src.bin')
    const dest = join(dir, 'dest.bin')
    await writeFile(src, 'payload', 'utf8')

    await moveFile(src, dest)

    strictEqual(await readFile(dest, 'utf8'), 'payload')
    strictEqual(await stat(src).then(() => true, () => false), false)
  })
})

describe('copyAcrossVolumes (EXDEV fallback)', () => {
  const exists = (p: string) => stat(p).then(() => true, () => false)

  it('copies via dest.part and leaves no partial file behind', async () => {
    const src = join(dir, 'xsrc.bin')
    const dest = join(dir, 'xdest.bin')
    await writeFile(src, 'payload', 'utf8')
    await copyAcrossVolumes(src, dest)
    strictEqual(await readFile(dest, 'utf8'), 'payload')
    strictEqual(await exists(dest + '.part'), false)
  })

  it('unlinks the partial copy when the final rename fails', async () => {
    const src = join(dir, 'fsrc.bin')
    const dest = join(dir, 'fdest-is-a-directory')
    await writeFile(src, 'payload', 'utf8')
    await mkdir(dest)
    await rejects(copyAcrossVolumes(src, dest))
    strictEqual(await exists(dest + '.part'), false)
  })
})
</file>

<file path="tests/paths.test.ts">
import { ok, strictEqual, throws } from 'node:assert/strict'
import { describe, it } from 'node:test'
import { resolveTorrentItemPath } from '../src/main/engine/torrent-path.ts'
import {
  intermediatePathsFor,
  isDracoIntermediate,
  partPathFor,
  workspaceDir
} from '../src/main/engine/workspace.ts'
import { normalizeDownloadDirectory, safeDownloadDirectory } from '../src/main/destination-path.ts'
import { toFolderName } from '../src/main/store-sanitize-path.ts'

it('escapes reserved Windows names before the first dot in category and group folders', () => {
  strictEqual(toFolderName('CON.tar'), 'CON_.tar')
  strictEqual(toFolderName('LPT³.backup'), 'LPT³_.backup')
})

/**
 * Path handling, which is both a correctness rule (one owner for every
 * intermediate) and a security boundary (a torrent names its own files, and a
 * peer chooses what those names are).
 */

describe('resolveTorrentItemPath', () => {
  const root = 'C:\\Downloads\\show'
  const allowed = ['show\\ep1.mkv', 'show\\extras\\clip.mkv']

  it('resolves a listed item beneath the root', () => {
    const target = resolveTorrentItemPath(root, 'show\\ep1.mkv', allowed)
    strictEqual(target, 'C:\\Downloads\\show\\show\\ep1.mkv')
  })

  it('resolves a nested listed item', () => {
    ok(resolveTorrentItemPath(root, 'show\\extras\\clip.mkv', allowed)?.endsWith('extras\\clip.mkv'))
  })

  it('refuses a path the metadata never listed', () => {
    // The allow-list is the whole defence: without it, a renderer bug or a
    // hostile torrent could name any file on the disk.
    strictEqual(resolveTorrentItemPath(root, 'show\\secret.mkv', allowed), null)
  })

  it('refuses traversal even when the torrent lists it', () => {
    strictEqual(resolveTorrentItemPath(root, '..\\..\\Windows\\System32\\drivers\\etc\\hosts', [
      '..\\..\\Windows\\System32\\drivers\\etc\\hosts'
    ]), null)
    strictEqual(resolveTorrentItemPath(root, 'show\\..\\..\\other.txt', ['show\\..\\..\\other.txt']), null)
    strictEqual(resolveTorrentItemPath(root, '..\\outside.txt', ['..\\outside.txt']), null)
  })

  it('permits filenames starting with dots that are not directory traversal', () => {
    const target = resolveTorrentItemPath(root, 'show\\..notes.txt', ['show\\..notes.txt'])
    strictEqual(target, 'C:\\Downloads\\show\\show\\..notes.txt')
  })

  it('refuses an absolute path that escapes the root', () => {
    strictEqual(resolveTorrentItemPath(root, 'C:\\Windows\\notepad.exe', ['C:\\Windows\\notepad.exe']), null)
  })

  it('refuses the root itself', () => {
    strictEqual(resolveTorrentItemPath(root, '.', ['.']), null, 'the root is not an item in it')
  })
})

describe('workspaceDir', () => {
  it('uses the shared temp dir only when it shares a volume with the destination', () => {
    // Across volumes the finishing move becomes a full copy - minutes of disk
    // time on a large download, and twice the space transiently.
    strictEqual(workspaceDir('C:\\Downloads', 'C:\\Temp'), 'C:\\Temp')
    strictEqual(workspaceDir('D:\\Downloads', 'C:\\Temp'), 'D:\\Downloads')
    strictEqual(workspaceDir('C:\\Downloads'), 'C:\\Downloads', 'no temp dir means beside the file')
  })

  it('isolates equal filenames by task identity on the destination volume', () => {
    const first = partPathFor('C:\\Downloads', 'clip.mp4', 'first', 'C:\\Temp')
    const second = partPathFor('C:\\Downloads', 'clip.mp4', 'second', 'C:\\Temp')
    ok(first.startsWith('C:\\Temp\\.draco-tasks\\'))
    ok(second.startsWith('C:\\Temp\\.draco-tasks\\'))
    ok(first.endsWith('\\data.dracodl'))
    ok(first !== second)
    ok(partPathFor('D:\\Downloads', 'clip.mp4', 'first', 'C:\\Temp').startsWith('D:\\Downloads\\.draco-tasks\\'))
  })
})

describe('isDracoIntermediate', () => {
  it('claims only Draco\'s own leftovers', () => {
    ok(isDracoIntermediate('clip.mp4.dracodl'))
    ok(isDracoIntermediate('clip.mp4.dracodl.json'))
    strictEqual(isDracoIntermediate('clip.mp4'), false, 'a finished download is not a leftover')
    strictEqual(isDracoIntermediate('holiday.jpg'), false)
  })
})

describe('intermediatePathsFor', () => {
  it('cleans only the task-owned workspace', () => {
    const { files, dirs } = intermediatePathsFor(
      { id: 'first', dir: 'C:\\Downloads', filename: 'clip.mp4', audioUrl: null },
      'C:\\Temp'
    )
    strictEqual(files.length, 0)
    strictEqual(dirs.length, 1)
    ok(dirs[0].startsWith('C:\\Temp\\.draco-tasks\\'))
  })

  it('does not remove another task sharing the final name', () => {
    const first = intermediatePathsFor(
      { id: 'first', dir: 'C:\\Downloads', filename: 'clip.mp4', audioUrl: 'https://example.test/audio.m4a' },
      'C:\\Temp'
    )
    const second = intermediatePathsFor(
      {
        id: 'second',
        dir: 'C:\\Downloads',
        filename: 'clip.mp4',
        audioUrl: 'https://example.test/audio.m4a',
        youtube: { videoFormatId: '137', audioFormatId: '140', pageUrl: 'https://youtube.com/watch?v=abc' }
      },
      'C:\\Temp'
    )
    ok(first.dirs[0] !== second.dirs[0])
  })
})

describe('download directory safety', () => {
  it('converts a picked path into an unambiguous Windows one', () => {
    strictEqual(normalizeDownloadDirectory('C:/Users/me/Downloads'), 'C:\\Users\\me\\Downloads')
    strictEqual(normalizeDownloadDirectory('C:\\Users\\me\\..\\me\\Downloads'), 'C:\\Users\\me\\Downloads')
    // A bare `D:` is drive-relative to Node but means the drive root to anyone
    // who picked it in a folder browser.
    strictEqual(normalizeDownloadDirectory('D:'), 'D:\\')
  })

  it('refuses anything that is not an absolute path', () => {
    throws(() => normalizeDownloadDirectory('Downloads'))
    throws(() => normalizeDownloadDirectory('   '))
    throws(() => normalizeDownloadDirectory('\\Downloads'))
    throws(() => normalizeDownloadDirectory('/Downloads'))
    throws(() => normalizeDownloadDirectory('D:Downloads'))
    strictEqual(normalizeDownloadDirectory('\\\\server\\share\\Media'), '\\\\server\\share\\Media')
  })

  it('falls back rather than trusting a stored value that is not an absolute path', () => {
    const fallback = 'C:\\Users\\me\\Downloads'
    strictEqual(safeDownloadDirectory('..\\..\\Windows', fallback), fallback)
    strictEqual(safeDownloadDirectory('', fallback), fallback)
    strictEqual(safeDownloadDirectory(42, fallback), fallback)
    strictEqual(safeDownloadDirectory(null, fallback), fallback)
    strictEqual(safeDownloadDirectory('D:\\Media', fallback), 'D:\\Media', 'a real path is kept')
  })
})

describe('toFolderName', () => {
  it('produces a Windows-safe subfolder from an arbitrary title', () => {
    strictEqual(toFolderName('Season 1: "Pilot"/Extras'), 'Season 1 PilotExtras')
    strictEqual(toFolderName('   '), 'Untitled')
    strictEqual(toFolderName('nul'), 'nul_')
    strictEqual(toFolderName('con.txt'), 'con_.txt', 'the device name must be escaped before the extension')
    strictEqual(toFolderName('aux.backup'), 'aux_.backup')
    strictEqual(toFolderName('x'.repeat(200)).length, 60, 'capped so the full path stays openable')
    strictEqual(toFolderName('x'.repeat(59) + '.continued'), 'x'.repeat(59), 'truncation must not leave a trailing dot')
  })
})
</file>

<file path="tools/build-firefox-extension.mjs">
import { cp, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { join } from 'node:path'

const root = process.cwd()
const source = join(root, 'extension')
const target = join(root, 'extension-firefox')

await rm(target, { recursive: true, force: true })
await mkdir(target, { recursive: true })
for (const name of ['background.js', 'content.js', 'popup.html', 'popup.js', 'icon.png', 'downloadButton.png']) {
  if (name.endsWith('.js')) {
    // Firefox's browser namespace consistently returns promises. The shared
    // Chromium files use chrome.* for Chrome's MV3 API surface.
    let script = (await readFile(join(source, name), 'utf8')).replace(/\bchrome\./g, 'browser.')
    if (name === 'background.js') {
      const chromeHeaders = "['requestHeaders', 'extraHeaders']"
      if (!script.includes(chromeHeaders)) throw new Error('Chromium request-header listener changed')
      script = script.replace(chromeHeaders, "['requestHeaders']")
      // browser.contextMenus.removeAll is promise-based in Firefox.
      script = script.replace(
        'browser.contextMenus.removeAll(() => {',
        'browser.contextMenus.removeAll().then(() => {'
      )
    }
    await writeFile(join(target, name), script, 'utf8')
  } else {
    await cp(join(source, name), join(target, name))
  }
}
await cp(join(source, 'status-icons'), join(target, 'status-icons'), { recursive: true })

const manifest = JSON.parse(await readFile(join(source, 'manifest.json'), 'utf8'))
delete manifest.key
delete manifest.minimum_chrome_version
manifest.permissions = manifest.permissions.filter((permission) => permission !== 'downloads.ui')
manifest.background = { scripts: ['background.js'] }
manifest.browser_specific_settings = {
  gecko: { id: 'draco@nihil.local', strict_min_version: '128.0' }
}
await writeFile(join(target, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n', 'utf8')
console.log(`built ${target}`)
</file>

<file path="tools/dl.ts">
/**
 * Terminal harness for the download engine.
 *
 *   node tools/dl.ts <url> [--dir DIR] [--conn N] [--limit BYTES_PER_SEC]
 *                          [--min-split BYTES] [--tasks N]
 *
 * The point of this file is to make the engine verifiable before any UI exists:
 * it prints the live segment table, so you can watch ranges get split off and
 * handed to freed connections, and confirm a Ctrl-C resumes at the right offsets.
 *
 * Runs directly under Node's type stripping - no build step.
 */
import { createTask, deterministicTaskId, validateUrl } from '../src/main/engine/create.ts'
import { DownloadManager, type EngineSettings } from '../src/main/engine/manager.ts'
import { Segmenter } from '../src/main/engine/segmenter.ts'
import type { DownloadTask } from '../src/shared/types.ts'

const args = process.argv.slice(2)
const urls: string[] = []
const flags = new Map<string, string>()

for (let i = 0; i < args.length; i++) {
  const arg = args[i]
  if (arg.startsWith('--')) {
    flags.set(arg.slice(2), args[++i] ?? '')
  } else {
    urls.push(arg)
  }
}

if (urls.length === 0) {
  console.error('usage: node tools/dl.ts <url> [--dir DIR] [--conn N] [--limit BPS]')
  process.exit(1)
}

function parseNum(val: string | undefined, def: number): number {
  if (!val) return def
  const n = Number(val)
  if (Number.isNaN(n)) {
    console.error(`Invalid numeric flag: ${val}`)
    process.exit(1)
  }
  return n
}

const settings: EngineSettings = {
  maxConcurrentTasks: parseNum(flags.get('tasks'), 3),
  maxConnectionsPerTask: parseNum(flags.get('conn'), 8),
  minSplitSize: parseNum(flags.get('min-split'), 1024 * 1024),
  retryLimit: 5,
  timeoutMs: 30_000,
  speedLimit: flags.has('limit') ? parseNum(flags.get('limit'), 0) : null,
  proxyUrl: null,
  hostConnectionLimits: [],
  quotaBytes: null,
  quotaWindowMinutes: 60,
  antivirusProgram: null,
  antivirusArgs: ['{file}'],
  antivirusTimeoutSeconds: 120
}

const dir = flags.get('dir') || process.cwd()
/** Test affordance: take the graceful pause path after N seconds. */
const stopAfter = flags.has('stop-after') ? parseNum(flags.get('stop-after'), 0) : null

let latest: DownloadTask[] = []
let lastLineCount = 0

const manager = new DownloadManager({
  getSettings: () => settings,
  onTasks: (tasks) => {
    latest = tasks
  },
  onProgress: () => render()
})

const tasks = urls.map((url) => {
  const task = createTask({ url: validateUrl(url), dir })
  // The partial and its journal are keyed by task id. A random one - which is
  // what createTask mints - meant "run the same command again to resume" below
  // actually started over every time.
  task.id = deterministicTaskId(task.url, dir.toLowerCase())
  return task
})
for (const task of tasks) manager.add(task)

function bytes(n: number | null): string {
  if (n === null) return '?'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let value = n
  let unit = 0
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024
    unit++
  }
  return `${value.toFixed(unit === 0 ? 0 : 1)} ${units[unit]}`
}

function duration(seconds: number | null): string {
  if (seconds === null) return '--:--'
  const s = Math.max(0, Math.round(seconds))
  const h = Math.floor(s / 3600)
  const m = Math.floor((s % 3600) / 60)
  const sec = s % 60
  return h > 0
    ? `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
    : `${m}:${String(sec).padStart(2, '0')}`
}

function bar(fraction: number, width = 24): string {
  const filled = Math.max(0, Math.min(width, Math.round(fraction * width)))
  return '█'.repeat(filled) + '░'.repeat(width - filled)
}

function render(): void {
  const lines: string[] = []

  for (const task of latest) {
    const pct = task.size ? task.received / task.size : 0
    lines.push(
      `${task.filename}  ${bytes(task.received)} / ${bytes(task.size)}  ` +
        `${task.status}${task.resumable ? '' : ' (no-resume)'}`
    )
    lines.push(
      `  ${bar(pct)} ${(pct * 100).toFixed(1)}%  ` +
        `${bytes(task.speed)}/s  eta ${duration(task.eta)}  ` +
        `${task.segments.filter((s) => s.active).length}/${task.connections} conn`
    )

    for (const [i, seg] of task.segments.entries()) {
      const total = seg.end < 0 ? 0 : seg.end - seg.start + 1
      const done = seg.position - seg.start
      const frac = total > 0 ? done / total : 0
      const rem = Segmenter.remaining(seg)
      lines.push(
        `    seg${String(i).padStart(2)} ${bar(frac, 16)} ` +
          `${String(Math.round(frac * 100)).padStart(3)}%  ` +
          `${seg.start}-${seg.end < 0 ? '?' : seg.end}  ` +
          `left ${bytes(rem === Infinity ? null : rem)}` +
          `${seg.active ? '  <' : ''}`
      )
    }

    if (task.error) lines.push(`  error: ${task.error}`)
    lines.push('')
  }

  // Redraw in place rather than scrolling the terminal.
  if (lastLineCount > 0) process.stdout.write(`[${lastLineCount}A[0J`)
  process.stdout.write(lines.join('\n') + '\n')
  lastLineCount = lines.length + 1
}

let finished = false
setInterval(() => {
  render()
  const allDone = latest.length > 0 && latest.every((t) => t.status === 'done' || t.status === 'error')
  if (allDone && !finished) {
    finished = true
    render()
    const failed = latest.filter((t) => t.status === 'error')
    process.exit(failed.length > 0 ? 1 : 0)
  }
}, 500)

// Ctrl-C must flush the journals, otherwise the whole point of the resume test
// is lost - the run would look resumable but have nothing to resume from.
let stopping = false

function gracefulStop(): void {
  if (stopping) process.exit(130)
  stopping = true
  console.log('\npausing and flushing journals...')
  void manager.shutdown().then(() => {
    render()
    console.log('paused. run the same command again to resume.')
    process.exit(130)
  })
}

process.on('SIGINT', gracefulStop)

// Same path as Ctrl-C, on a timer, so the resume test is reproducible instead of
// depending on how fast a human can hit the key.
if (stopAfter !== null) setTimeout(gracefulStop, stopAfter * 1000)
</file>

<file path="tools/register-host.ps1">
<#
.SYNOPSIS
  Registers Draco's native-messaging host with Chrome, Edge, Brave, Opera, Vivaldi and Firefox.

.DESCRIPTION
  Draco does this for itself on every launch (see src/main/bridge/integration.ts), so this script
  is for the case where it cannot: the app will not start, the registration is being inspected, or
  the extension needs to be wired up against a build that is not running.

  It writes the native-messaging manifest to %APPDATA%\Draco and points each browser's HKCU key at
  it. Registration is per-user by design - no elevation, nothing left behind for other accounts.

.PARAMETER AppExe
  The Draco executable the host should start when the app is not running. Defaults to the installed
  copy, falling back to the dev launcher.

.PARAMETER Remove
  Deletes the registry keys and the manifest instead of writing them.

.EXAMPLE
  powershell -ExecutionPolicy Bypass -File tools/register-host.ps1
#>

[CmdletBinding()]
param(
  [string]$AppExe,
  [switch]$Remove
)

$ErrorActionPreference = 'Stop'

$HostName = 'com.nihil.draco'
$RepoRoot = Split-Path -Parent $PSScriptRoot
$DataDir = Join-Path $env:APPDATA 'Draco'
$ManifestPath = Join-Path $DataDir "$HostName.json"
$FirefoxManifestPath = Join-Path $DataDir "$HostName.firefox.json"

# Each browser reads a different key, and all three are Chromium.
$RegistryKeys = @{
  Chrome = "HKCU:\Software\Google\Chrome\NativeMessagingHosts\$HostName"
  Edge   = "HKCU:\Software\Microsoft\Edge\NativeMessagingHosts\$HostName"
  Brave  = "HKCU:\Software\BraveSoftware\Brave-Browser\NativeMessagingHosts\$HostName"
  Opera  = "HKCU:\Software\Opera Software\NativeMessagingHosts\$HostName"
  Vivaldi = "HKCU:\Software\Vivaldi\NativeMessagingHosts\$HostName"
  Firefox = "HKCU:\Software\Mozilla\NativeMessagingHosts\$HostName"
}

if ($Remove) {
  foreach ($entry in $RegistryKeys.GetEnumerator()) {
    if (Test-Path $entry.Value) {
      Remove-Item $entry.Value -Recurse -Force
      Write-Output "removed $($entry.Key)"
    }
  }
  if (Test-Path $ManifestPath) {
    Remove-Item $ManifestPath -Force
    Write-Output "removed $ManifestPath"
  }
  if (Test-Path $FirefoxManifestPath) {
    Remove-Item $FirefoxManifestPath -Force
    Write-Output "removed Firefox manifest"
  }
  return
}

# --- The extension ID -------------------------------------------------------
# It is pinned by the "key" field in the manifest, and allowed_origins has to
# match it exactly or Chrome refuses the connection with no useful error.

$ExtensionManifest = Join-Path $RepoRoot 'extension\manifest.json'
if (-not (Test-Path $ExtensionManifest)) {
  throw "No extension manifest at $ExtensionManifest"
}

$extension = Get-Content $ExtensionManifest -Raw | ConvertFrom-Json
if (-not $extension.key) {
  throw 'The extension manifest has no "key". Run: npm run keygen'
}

$der = [Convert]::FromBase64String($extension.key)
$sha = [System.Security.Cryptography.SHA256]::Create().ComputeHash($der)

# Chrome's ID is the first 16 bytes of SHA-256(DER), hex-encoded, with 0-9a-f
# mapped onto a-p.
$id = -join ($sha[0..15] | ForEach-Object {
  $hex = '{0:x2}' -f $_
  -join ($hex.ToCharArray() | ForEach-Object {
    [char]([int][char]'a' + [Convert]::ToInt32([string]$_, 16))
  })
})

# --- The host binary and the app it starts ---------------------------------

$HostExe = Join-Path $RepoRoot 'host\draco-host.exe'
if (-not (Test-Path $HostExe)) {
  throw "No host binary at $HostExe. Run: npm run host"
}

if (-not $AppExe) {
  $candidates = @(
    (Join-Path $env:LOCALAPPDATA 'Programs\draco\Draco.exe'),
    (Join-Path $RepoRoot 'node_modules\electron\dist\electron.exe')
  )
  $AppExe = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
}
if (-not $AppExe) {
  throw 'Could not find Draco.exe; pass -AppExe <path>'
}

New-Item -ItemType Directory -Force -Path $DataDir | Out-Null

$utf8NoBom = New-Object System.Text.UTF8Encoding $false

$manifestJson = @{
  name           = $HostName
  description    = 'Draco download manager bridge'
  path           = $HostExe
  type           = 'stdio'
  allowed_origins = @("chrome-extension://$id/")
} | ConvertTo-Json -Depth 4
[System.IO.File]::WriteAllText($ManifestPath, $manifestJson, $utf8NoBom)

$firefoxManifestJson = @{
  name               = $HostName
  description        = 'Draco download manager bridge'
  path               = $HostExe
  type               = 'stdio'
  allowed_extensions = @('draco@nihil.local')
} | ConvertTo-Json -Depth 4
[System.IO.File]::WriteAllText($FirefoxManifestPath, $firefoxManifestJson, $utf8NoBom)

# The host reads this to know what to launch when the pipe is not answering.
$appArguments = if ([System.IO.Path]::GetFileName($AppExe) -ieq 'electron.exe') { @($RepoRoot) } else { @() }
$hostConfigJson = @{ appPath = $AppExe; appArgs = @($appArguments) } | ConvertTo-Json
[System.IO.File]::WriteAllText((Join-Path $DataDir 'host-config.json'), $hostConfigJson, $utf8NoBom)

foreach ($entry in $RegistryKeys.GetEnumerator()) {
  $targetManifest = if ($entry.Key -eq 'Firefox') { $FirefoxManifestPath } else { $ManifestPath }
  New-Item -Path $entry.Value -Force | Out-Null
  Set-ItemProperty -Path $entry.Value -Name '(Default)' -Value $targetManifest
  Write-Output "registered $($entry.Key)"
}

Write-Output ''
Write-Output "extension id : $id"
Write-Output "host         : $HostExe"
Write-Output "app          : $AppExe"
Write-Output "manifest     : $ManifestPath"
Write-Output ''
Write-Output "Load unpacked from: $(Join-Path $RepoRoot 'extension')"
</file>

