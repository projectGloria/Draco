<file path="src/main/ytdlp-cookies.ts">
/**
 * Letting yt-dlp borrow a browser's cookies.
 *
 * Draco already carries the browser's cookies for an ordinary download - the
 * extension captures them at the moment of the click. A page Draco resolves by
 * itself has no such moment: a members-only video, an age-gated one, anything
 * behind a login is simply "unavailable" to an anonymous extractor, however
 * plainly it plays in the browser next door.
 *
 * yt-dlp can read those cookies from the browser's own profile. The name of the
 * browser is the whole input, and it is checked against this list rather than
 * passed through, because it becomes an argument to a program: an unchecked
 * string here is a way to hand yt-dlp flags nobody asked for.
 */

export const COOKIE_BROWSERS = [
  'chrome',
  'edge',
  'brave',
  'firefox',
  'chromium',
  'opera',
  'vivaldi'
] as const

export type CookieBrowser = (typeof COOKIE_BROWSERS)[number]

/** 'none' is the default and the only way to send no cookies at all. */
export type CookieSource = CookieBrowser | 'none'

export function isCookieBrowser(value: unknown): value is CookieBrowser {
  return typeof value === 'string' && (COOKIE_BROWSERS as readonly string[]).includes(value)
}

/**
 * The arguments that make yt-dlp read a browser profile, or none.
 *
 * Nothing is guessed: an unknown name yields no arguments rather than a best
 * effort, so a setting written by hand into settings.json cannot turn into a
 * command-line flag.
 */
export function cookieArgs(source: unknown): string[] {
  return isCookieBrowser(source) ? ['--cookies-from-browser', source] : []
}

/**
 * Why a cookie read failed, in words that name the fix.
 *
 * Two of these are common enough to be worth recognising: Chromium locks its
 * cookie database while it is running on Windows, and its newer profiles seal
 * the key so that only the browser itself can decrypt them.
 */
export function explainCookieFailure(stderr: string, browser: CookieSource): string | null {
  if (browser === 'none') return null
  const text = stderr.toLowerCase()

  if (text.includes('could not copy') || text.includes('permission denied') || text.includes('database is locked')) {
    return `Draco could not read ${browser}'s cookies while it is running. Close ${browser} and try again.`
  }
  if (text.includes('failed to decrypt') || text.includes('unable to get key') || text.includes('dpapi')) {
    return `${browser} is storing its cookies in a form yt-dlp cannot decrypt on this machine. Try another browser in Options.`
  }
  if (text.includes('could not find') && text.includes('cookies')) {
    return `No ${browser} profile with cookies was found. Check the browser chosen in Options.`
  }
  return null
}
</file>

<file path="src/main/ytdlp-digest.ts">
import { createHash } from 'node:crypto'
import { fetchGuarded } from './fetch-guard.ts'
import { parseSha256 } from './tools-version.ts'

type SumsFetcher = (url: string, options: { signal: AbortSignal }) => Promise<Response>
const guardedSumsFetch: SumsFetcher = (url, options) =>
  fetchGuarded(url, {
    headers: { 'user-agent': 'Draco' }, signal: options.signal,
    timeoutMs: 20_000, requireHttps: true
  })

/** A downloaded executable may be installed only when the publisher digest matches. */
export async function verifyYtDlpDigest(
  body: Buffer,
  sumsUrl: string,
  fetchSums: SumsFetcher = guardedSumsFetch
): Promise<void> {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 20_000)
  try {
    const response = await fetchSums(sumsUrl, { signal: controller.signal })
    if (!response.ok) throw new Error(`publisher checksum request returned HTTP ${response.status}`)
    const declared = Number(response.headers.get('content-length') ?? 0)
    if (declared > 100_000) throw new Error('publisher checksum file is too large')

    const reader = response.body?.getReader()
    if (!reader) throw new Error('publisher checksum file is empty')
    const chunks: Uint8Array[] = []
    let size = 0
    try {
      for (;;) {
        const { done, value } = await reader.read()
        if (done) break
        size += value.length
        if (size > 100_000) throw new Error('publisher checksum file is too large')
        chunks.push(value)
      }
    } finally {
      await reader.cancel().catch(() => {})
      reader.releaseLock()
    }
    const text = Buffer.concat(chunks, size).toString('utf8')
    const line = text.split('\n').find((entry) => /\s\*?yt-dlp\.exe\s*$/i.test(entry.trim()))
    const expected = line ? parseSha256(line) : null
    if (!expected) throw new Error('publisher checksum for yt-dlp.exe is missing or invalid')

    const actual = createHash('sha256').update(body).digest('hex')
    if (actual !== expected) throw new Error('yt-dlp.exe does not match its published SHA-256 digest')
  } finally {
    clearTimeout(timer)
  }
}
</file>

<file path="src/renderer/splash/main.ts">
import type { BootstrapState } from '@shared/types'

/**
 * The splash renderer. No framework here on purpose: this window exists to be
 * on screen before anything else is, and pulling React in would defeat that.
 */

const stepsEl = document.getElementById('steps') as HTMLDivElement
const fillEl = document.getElementById('fill') as HTMLDivElement
const pctEl = document.getElementById('pct') as HTMLSpanElement
const currentEl = document.getElementById('current') as HTMLSpanElement
const errorEl = document.getElementById('error') as HTMLDivElement
const retryBtn = document.getElementById('retry') as HTMLButtonElement
const continueBtn = document.getElementById('continue') as HTMLButtonElement

interface Row {
  root: HTMLDivElement
  label: HTMLSpanElement
  detail: HTMLSpanElement
}

/** Rows are created once and then patched, so nothing flickers on each update. */
const rows = new Map<string, Row>()

function rowFor(id: string, label: string): Row {
  const existing = rows.get(id)
  if (existing) return existing

  const root = document.createElement('div')
  root.className = 'step'
  root.dataset.status = 'pending'

  const dot = document.createElement('span')
  dot.className = 'dot'

  const labelEl = document.createElement('span')
  labelEl.className = 'label'
  labelEl.textContent = label

  const detailEl = document.createElement('span')
  detailEl.className = 'detail'

  root.append(dot, labelEl, detailEl)
  stepsEl.append(root)

  const entry: Row = { root, label: labelEl, detail: detailEl }
  rows.set(id, entry)
  return entry
}

function render(state: BootstrapState): void {
  for (const step of state.steps) {
    const row = rowFor(step.id, step.label)
    row.root.dataset.status = step.status
    row.label.textContent = step.label
    // textContent, never innerHTML: a step's detail is an error string that came
    // from a filesystem path, a registry call or a socket.
    row.detail.textContent = step.detail ?? ''
  }

  fillEl.style.width = state.overall + '%'
  pctEl.textContent = Math.round(state.overall) + '%'

  const running = state.steps.find((s) => s.status === 'running')
  currentEl.textContent = state.error
    ? 'Something went wrong'
    : state.done
      ? 'Ready'
      : (running?.label ?? 'Starting…')

  if (state.error) {
    document.body.classList.add('failed')
    errorEl.textContent = state.error.message
    continueBtn.hidden = !state.error.canContinue
  } else {
    document.body.classList.remove('failed')
  }

  // The main window takes over from here; fade out rather than blink away.
  if (state.done) document.body.classList.add('leaving')
}

retryBtn.addEventListener('click', () => {
  document.body.classList.remove('failed')
  currentEl.textContent = 'Retrying…'
  void window.api.bootstrapRetry()
})

continueBtn.addEventListener('click', () => {
  void window.api.bootstrapContinue()
})

window.api.onBootstrap(render)
</file>

