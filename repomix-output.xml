  })

  for (const decision of ['accepted', 'dismissed'] as const) {
    it(`${decision} confirmation ${decision === 'accepted' ? 'cancels' : 'resumes'} the browser item`, async () => {
      const source = await readFile(resolve(root, 'extension', 'background.js'), 'utf8')
