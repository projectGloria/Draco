import { createHash } from 'node:crypto'
import { createReadStream } from 'node:fs'
import { pipeline } from 'node:stream/promises'
import { parseSha256 } from '../tools-version.ts'
import { fetchGuarded } from '../fetch-guard.ts'
import { readResponseText } from '../response-limit.ts'

type DigestFetcher = (url: string, options: { signal: AbortSignal }) => Promise<Response>
const guardedDigestFetch: DigestFetcher = (url, options) =>
  fetchGuarded(url, { signal: options.signal, timeoutMs: 30_000, requireHttps: true })

/** Refuse executable archives whose publisher digest cannot be checked. */
export async function verifyArchiveDigest(
  archivePath: string,
  sha256Url: string,
  fetchDigest: DigestFetcher = guardedDigestFetch
): Promise<void> {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 30_000)
  let published: string | null = null
  try {
    const response = await fetchDigest(sha256Url, {
      signal: controller.signal
    })
    if (!response.ok) throw new Error(`HTTP ${response.status}`)
    const size = Number(response.headers.get('content-length'))
    if (Number.isFinite(size) && size > 4096) throw new Error('Digest file is too large')
    published = parseSha256(await readResponseText(response, 4096))
  } catch (error) {
    throw new Error(`Could not verify ffmpeg archive: ${error instanceof Error ? error.message : String(error)}`)
  } finally {
    clearTimeout(timer)
  }

  if (!published) throw new Error('Could not verify ffmpeg archive: publisher digest is missing or invalid')
  const hash = createHash('sha256')
  await pipeline(createReadStream(archivePath), hash)
  const actual = hash.digest('hex')
  if (actual !== published) throw new Error('Ffmpeg archive does not match its published SHA-256 digest')
}
</file>

<file path="src/main/hls/encrypted-buffer.ts">
export const MAX_ENCRYPTED_SEGMENT_BYTES = 32 * 1024 * 1024

export class EncryptedSegmentTooLargeError extends Error {
  constructor() {
    super('Encrypted HLS segment exceeds 32 MiB; this stream needs smaller segments')
  }
}

/** Holds one AES-CBC segment until decryption, with a strict memory ceiling. */
export class EncryptedSegmentBuffer {
  private chunks: Buffer[] = []
  private size = 0

  reset(): void {
    this.chunks = []
    this.size = 0
  }

  write(chunk: Buffer): void {
    if (chunk.length > MAX_ENCRYPTED_SEGMENT_BYTES - this.size) {
      throw new EncryptedSegmentTooLargeError()
    }
    this.size += chunk.length
    this.chunks.push(chunk)
  }

  value(): Buffer {
    return Buffer.concat(this.chunks, this.size)
  }
}
</file>

<file path="src/main/hls/encrypted-pool.ts">
/** Bound complete encrypted HLS pieces across every task in this process. */
const MAX_BUFFERED_SEGMENTS = 4

interface Waiter {
  signal: AbortSignal
  resolve(release: () => void): void
  reject(error: Error): void
  onAbort(): void
}

let active = 0
const waiting: Waiter[] = []

function releasePermit(): void {
  for (;;) {
    const next = waiting.shift()
    if (!next) { active--; return }
    next.signal.removeEventListener('abort', next.onAbort)
    if (next.signal.aborted) {
      next.reject(new Error('Encrypted segment wait was cancelled'))
      continue
    }
    next.resolve(releaseOnce())
    return
  }
}

function releaseOnce(): () => void {
  let released = false
  return () => {
    if (released) return
    released = true
    releasePermit()
  }
}

function acquire(signal: AbortSignal): Promise<() => void> {
  if (signal.aborted) return Promise.reject(new Error('Encrypted segment wait was cancelled'))
  if (active < MAX_BUFFERED_SEGMENTS) {
    active++
    return Promise.resolve(releaseOnce())
  }
  return new Promise((resolve, reject) => {
    const waiter: Waiter = {
      signal, resolve, reject,
      onAbort() {
        const index = waiting.indexOf(waiter)
        if (index >= 0) waiting.splice(index, 1)
        signal.removeEventListener('abort', waiter.onAbort)
        reject(new Error('Encrypted segment wait was cancelled'))
      }
    }
    waiting.push(waiter)
    signal.addEventListener('abort', waiter.onAbort, { once: true })
    if (signal.aborted) waiter.onAbort()
  })
}

export async function withEncryptedSegmentSlot<T>(
  signal: AbortSignal,
  operation: () => Promise<T>
): Promise<T> {
  const release = await acquire(signal)
  try {
    signal.throwIfAborted()
    return await operation()
  } finally {
    release()
  }
}
</file>

