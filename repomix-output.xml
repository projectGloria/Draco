<file path="src/main/engine/connection-budget.ts">
/**
 * How a merged video+audio download divides its connection allowance.
 *
 * Pure and Electron-free, in `engine/`, for the reason every other decision
 * module here is: the runner that uses it reaches ffmpeg and cannot be loaded
 * under bare Node, and this is the part worth testing without a build.
 *
 * Two things were wrong with the `maxConnections / 2` this replaces.
 *
 * The split was even, and the streams are not: an audio track is typically
 * 5-10% of the bytes, so half the allowance sat on the half that finishes first
 * while the half that sets the length of the download ran narrow. Audio takes a
 * quarter here, never fewer than one; video takes the rest.
 *
 * And there was no ceiling at all. `TaskRunner` computes
 * `connectionTarget = max(maxConnections, connectionCeiling ?? 0)` and starts
 * the ramp at `min(RAMP_START_CONNECTIONS, target)`; with a target of 4 those
 * are the same number, and `ConnectionRamp` marks itself `done` on construction
 * when `current >= target`. Every YouTube video+audio download therefore ran at
 * exactly four connections per stream and could never climb, however much the
 * link had left - and the "Adaptive ceiling" setting did nothing whatsoever for
 * the downloads most likely to want it.
 */
export interface ConnectionBudget {
  video: number
  audio: number
  videoCeiling: number
  audioCeiling: number
}

export function splitConnectionBudget(
  maxConnections: number,
  connectionCeiling?: number
): ConnectionBudget {
  const base = Math.max(1, Math.floor(maxConnections))
  // A ceiling below the configured maximum is not a ceiling; it is a number
  // somebody left behind, and the maximum still applies.
  const ceiling = Math.max(base, Math.floor(connectionCeiling ?? 0))

  const audio = Math.max(1, Math.round(base / 4))
  const video = Math.max(1, base - audio)
  const audioCeiling = Math.max(audio, Math.round(ceiling / 4))
  const videoCeiling = Math.max(video, ceiling - audioCeiling)

  return { video, audio, videoCeiling, audioCeiling }
}
</file>

<file path="src/main/engine/duplicate.ts">
import type { DownloadTask } from '../../shared/types.ts'

/**
 * "Haven't I already got this?"
 *
 * Nothing in Draco used to ask. Pasting a link a second time started a second
 * download beside the first, and the only sign was a file named `thing (1).iso`
 * appearing next to `thing.iso` some minutes later.
 *
 * This never blocks an add: a duplicate is a thing worth *saying*, not a thing
 * worth refusing. Re-downloading is a legitimate request - the file changed, the
 * first copy was deleted, the first attempt was corrupt - and a downloader that
 * argues about it is worse than one that stays quiet.
 */

export type DuplicateReason = 'url' | 'destination'

export interface DuplicateMatch {
  taskId: string
  reason: DuplicateReason
  /** The existing task's state, so the caller can word it properly. */
  status: DownloadTask['status']
  filename: string
  dir: string
  completedAt: number | null
}

/**
 * A comparable form of a URL.
 *
 * The fragment never reaches the server. The host is case-insensitive and the
 * default port is implied. Everything else - including the query - is kept,
 * because for a great many download endpoints the query *is* the identity of
 * the file, and dropping it would report two different downloads as one.
 */
export function comparableUrl(value: string): string | null {
  try {
    const url = new URL(value)
    if (url.protocol === 'magnet:') {
      // A magnet's identity is its info hash; trackers and display names vary
      // between copies of the same link.
      const hash = /xt=urn:btih:([a-z0-9]+)/i.exec(url.href)?.[1]
      return hash ? `magnet:${hash.toLowerCase()}` : url.href.toLowerCase()
    }

    url.hash = ''
    url.hostname = url.hostname.toLowerCase()
    if ((url.protocol === 'https:' && url.port === '443') || (url.protocol === 'http:' && url.port === '80')) {
      url.port = ''
    }
    return url.toString()
  } catch {
    return null
  }
}

/**
 * Whether these two URLs stand for the same download.
 *
 * A signed media URL is deliberately *not* compared on its query: the signature
 * and its expiry change on every lookup, so two links to the same YouTube video
 * an hour apart share nothing but the path. Those are matched by the stable
 * page identity instead - see `findDuplicate`.
 */
export function sameResource(left: string, right: string): boolean {
  const a = comparableUrl(left)
  const b = comparableUrl(right)
  return a !== null && a === b
}

/**
 * An existing task this URL would repeat, or null.
 *
 * Three identities are checked, in the order they are worth reporting:
 * the stable page identity of a signed media URL, the URL itself, and the file
 * the download would land on. The last one catches the case the first two
 * cannot - the same file offered from a different address, or an entry the user
 * renamed.
 */
export function findDuplicate(
  tasks: readonly DownloadTask[],
  candidate: { url: string; pageUrl?: string | null; dir?: string; filename?: string },
  ignoreTaskId?: string
): DuplicateMatch | null {
  const comparable = comparableUrl(candidate.url)
  const pageUrl = candidate.pageUrl ? comparableUrl(candidate.pageUrl) : null

  let destinationMatch: DuplicateMatch | null = null

  for (const task of tasks) {
    if (task.id === ignoreTaskId) continue

    // The page a signed URL came from, which outlives the signature.
    if (pageUrl && task.youtube?.pageUrl && comparableUrl(task.youtube.pageUrl) === pageUrl) {
      return describe(task, 'url')
    }

    if (comparable && comparableUrl(task.url) === comparable) {
      return describe(task, 'url')
    }

    // Kept rather than returned at once: a URL match is the more meaningful
    // answer, and there may still be one later in the list.
    if (
      !destinationMatch &&
      candidate.filename &&
      candidate.dir &&
      task.status === 'done' &&
      task.filename === candidate.filename &&
      task.dir.toLowerCase() === candidate.dir.toLowerCase()
    ) {
      destinationMatch = describe(task, 'destination')
    }
  }

  return destinationMatch
}

function describe(task: DownloadTask, reason: DuplicateReason): DuplicateMatch {
  return {
    taskId: task.id,
    reason,
    status: task.status,
    filename: task.filename,
    dir: task.dir,
    completedAt: task.completedAt
  }
}
</file>

<file path="src/main/engine/finalization-pool.ts">
interface Waiter {
  signal: AbortSignal
  resolve: (release: (() => void) | null) => void
  onAbort: () => void
}

/** Caps post-transfer work without occupying a download connection slot. */
export class FinalizationPool {
  private active = 0
  private waiters: Waiter[] = []
  private readonly limit: number

  constructor(limit: number) {
    if (!Number.isSafeInteger(limit) || limit < 1) throw new RangeError('Finalization limit must be positive')
    this.limit = limit
  }

  get saturated(): boolean {
    return this.active >= this.limit
  }

  acquire(signal: AbortSignal): Promise<(() => void) | null> {
    if (signal.aborted) return Promise.resolve(null)
    if (this.active < this.limit) {
      this.active++
      return Promise.resolve(this.releaseOnce())
    }

    return new Promise((resolve) => {
      const waiter: Waiter = {
        signal,
        resolve,
        onAbort: () => {
          const index = this.waiters.indexOf(waiter)
          if (index !== -1) this.waiters.splice(index, 1)
          signal.removeEventListener('abort', waiter.onAbort)
          resolve(null)
        }
      }
      this.waiters.push(waiter)
      signal.addEventListener('abort', waiter.onAbort, { once: true })
      if (signal.aborted) waiter.onAbort()
    })
  }

  /** A quit lets active checks finish but leaves queued ones recoverable. */
  cancelPending(): void {
    for (const waiter of this.waiters.splice(0)) {
      waiter.signal.removeEventListener('abort', waiter.onAbort)
      waiter.resolve(null)
    }
  }

  private releaseOnce(): () => void {
    let released = false
    return () => {
      if (released) return
      released = true
      this.active--
      while (this.active < this.limit && this.waiters.length > 0) {
        const waiter = this.waiters.shift()!
        waiter.signal.removeEventListener('abort', waiter.onAbort)
        if (waiter.signal.aborted) {
          waiter.resolve(null)
          continue
        }
        this.active++
        waiter.resolve(this.releaseOnce())
      }
    }
  }
}
</file>

<file path="src/main/engine/limit-window.ts">
/**
 * A speed limit that only applies at certain hours.
 *
 * One global cap is the wrong shape for the machine a download manager
 * actually runs on: the reason to throttle at all is usually "while I am using
 * this computer", and the reason to stop throttling is "while I am asleep". A
 * setting you have to remember to flip twice a day is one you stop flipping.
 *
 * Pure, and separate from the queue scheduler's own windows, because the two
 * answer different questions - which tasks may run, versus how fast anything
 * may go - and only this one is consulted on every tick.
 */

export interface ScheduledLimit {
  /** "HH:MM" local time. */
  startTime: string
  stopTime: string
  /** Bytes per second while the window is open. */
  bytesPerSecond: number
}

/** Minutes since midnight, or null when the value is not a time. */
export function parseClock(value: unknown): number | null {
  if (typeof value !== 'string') return null
  const match = /^(\d{1,2}):(\d{2})$/.exec(value.trim())
  if (!match) return null
  const hours = Number(match[1])
  const minutes = Number(match[2])
  if (hours > 23 || minutes > 59) return null
  return hours * 60 + minutes
}

/**
 * Whether `now` falls inside the window.
 *
 * A stop time earlier than the start means the window crosses midnight, which
 * is the common case for this setting - 08:00 to 23:00 is one shape of the
 * request, 23:00 to 08:00 is the other. The start minute is inside and the stop
 * minute is outside, so two windows can meet without overlapping.
 */
export function withinWindow(startTime: unknown, stopTime: unknown, now: Date): boolean {
  const start = parseClock(startTime)
  const stop = parseClock(stopTime)
  if (start === null || stop === null) return false
  // A window that starts and stops at the same minute has no hours in it. It is
  // read as "never" rather than "always": an accidental 00:00-00:00 must not
  // throttle the app around the clock.
  if (start === stop) return false

  const minutes = now.getHours() * 60 + now.getMinutes()
  return stop > start ? minutes >= start && minutes < stop : minutes >= start || minutes < stop
}

/**
 * The cap in force right now: the scheduled one while its window is open,
 * otherwise the ordinary one.
 *
 * The scheduled limit replaces rather than combines. Two numbers that both
 * apply would need a rule for which wins, and the honest reading of "limit to
 * 200 KB/s between 9 and 5" is that between 9 and 5 the limit is 200 KB/s.
 */
export function effectiveSpeedLimit(
  settings: { speedLimit: number | null; scheduledLimit?: ScheduledLimit | null },
  now: Date = new Date()
): number | null {
  const scheduled = settings.scheduledLimit
  if (
    scheduled &&
    Number.isFinite(scheduled.bytesPerSecond) &&
    scheduled.bytesPerSecond > 0 &&
    withinWindow(scheduled.startTime, scheduled.stopTime, now)
  ) {
    return scheduled.bytesPerSecond
  }
  return settings.speedLimit
}
