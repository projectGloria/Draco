      <header>
        <div class="mark">
          <img src="../../resources/icon-splash.png" alt="" />
        </div>
        <div>
          <h1>Draco</h1>
          <div class="tag">Getting things ready…</div>
        </div>
      </header>

      <div class="steps" id="steps"></div>

