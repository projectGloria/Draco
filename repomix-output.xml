/** Bounds retained data URLs by size as well as count, with least-recently-used eviction. */
export class ThumbnailCache {
  private entries = new Map<string, { value: string | null; bytes: number }>()
  private bytes = 0
  private readonly maxEntries: number
  private readonly maxBytes: number

  constructor(maxEntries: number, maxBytes: number) {
    this.maxEntries = maxEntries
    this.maxBytes = maxBytes
  }

  get(key: string): string | null | undefined {
    const entry = this.entries.get(key)
    if (!entry) return undefined
    this.entries.delete(key)
    this.entries.set(key, entry)
    return entry.value
  }

  set(key: string, value: string | null): void {
    const previous = this.entries.get(key)
    if (previous) {
      this.entries.delete(key)
      this.bytes -= previous.bytes
    }
    // Use the UTF-16 upper bound even when V8 can store ASCII more compactly.
    const bytes = 2 * (key.length + (value?.length ?? 0)) + 64
    if (bytes > this.maxBytes) return
    this.entries.set(key, { value, bytes })
    this.bytes += bytes
    while (this.entries.size > this.maxEntries || this.bytes > this.maxBytes) {
      const oldest = this.entries.keys().next().value!
      this.bytes -= this.entries.get(oldest)!.bytes
      this.entries.delete(oldest)
    }
  }
}
</file>

<file path="src/main/thumbnails.ts">
import { createHash } from 'node:crypto'
import { mkdir, readdir, readFile, rm, stat, writeFile } from 'node:fs/promises'
import { join } from 'node:path'
import { getPaths } from './bootstrap/paths.ts'
import { validateUrl } from './engine/create.ts'
import { fetchGuarded } from './fetch-guard.ts'
import { readResponseBytes } from './response-limit.ts'
import { DEFAULT_USER_AGENT } from './engine/probe.ts'
import { logger } from './log.ts'
import { ThumbnailCache } from './thumbnail-cache.ts'
import { FinalizationPool } from './engine/finalization-pool.ts'

const log = logger('thumbnails')

/**
 * Poster images for the rows that have one - a YouTube video, a media page.
 *
 * These are fetched here and handed to the renderer as data URLs for the same
 * reason `icons.ts` does it: every window ships with `img-src 'self' data:`, and
 * a preview that loads straight from `i.ytimg.com` is both a hole in that and a
 * request the renderer makes on its own behalf. Widening the CSP would have been
 * one line and would have let any resolver-supplied host be contacted by a
 * window; this keeps the fetch in main, where the proxy and the URL guard
 * already live, and the window only ever sees bytes it cannot navigate to.
 *
 * The URL originates in web content - it is whatever yt-dlp or a page's own
 * markup claimed - so it goes through `validateUrl` with private addresses
 * refused, exactly like a download URL arriving from the extension.
 */

/** Data URL per source URL, `null` when the fetch produced nothing usable. */
const thumbnails = new ThumbnailCache(600, 32 * 1024 * 1024)
const thumbnailWork = new Map<string, Promise<string | null>>()
const thumbnailSlots = new FinalizationPool(4)

const THUMBNAIL_TIMEOUT_MS = 8_000
const THUMBNAIL_MAX_BYTES = 2 * 1024 * 1024
/** Files kept on disk, so reopening the same playlist costs no requests. */
const THUMBNAIL_DISK_MAX = 1200

export async function thumbnailFor(rawUrl: string): Promise<string | null> {
  let url: string
  try {
    // Not just a parse: this is the guard that stops a resolver-supplied
    // "thumbnail" aiming main at the router or at localhost.
    url = validateUrl(rawUrl, { allowPrivate: false })
  } catch {
    return null
  }
  if (!/^https:/i.test(url)) return null

  const cached = thumbnails.get(url)
  if (cached !== undefined) return cached

  const existing = thumbnailWork.get(url)
  if (existing) return existing

  const work = (async () => {
    // A playlist can request hundreds together. Bound disk reads, network
    // buffers and base64 conversion as well as the retained cache.
    const release = await thumbnailSlots.acquire(new AbortController().signal)
    try {
      const saved = await readCached(url)
      if (saved) return saved

      const fetched = await fetchThumbnail(url)
      if (fetched) await writeCached(url, fetched)
      return fetched
    } finally {
      release?.()
    }
  })().catch((err: unknown) => {
    log.warn(`no thumbnail for ${url}: ${String(err)}`)
    return null
  })

  thumbnailWork.set(url, work)
  const result = await work
  thumbnailWork.delete(url)

  thumbnails.set(url, result)

  return result
}

function cachePath(url: string): string {
  const key = createHash('sha256').update(url).digest('hex')
  return join(getPaths().iconCache, 'thumbnails', `${key}.json`)
}

async function readCached(url: string): Promise<string | null> {
  try {
    const parsed = JSON.parse(await readFile(cachePath(url), 'utf8')) as {
      url?: unknown
      dataUrl?: unknown
    }
    if (parsed.url !== url || typeof parsed.dataUrl !== 'string') return null
    if (!/^data:image\/[a-z0-9.+-]+;base64,/i.test(parsed.dataUrl)) return null
    if (parsed.dataUrl.length > THUMBNAIL_MAX_BYTES * 2) return null
    return parsed.dataUrl
  } catch {
    return null
  }
}

async function writeCached(url: string, dataUrl: string): Promise<void> {
  const dir = join(getPaths().iconCache, 'thumbnails')
  await mkdir(dir, { recursive: true })
  await writeFile(cachePath(url), JSON.stringify({ url, dataUrl }), 'utf8')
  await trimCache(dir)
}

async function trimCache(dir: string): Promise<void> {
  try {
    const names = (await readdir(dir)).filter((name) => name.endsWith('.json'))
    if (names.length <= THUMBNAIL_DISK_MAX) return

    const dated = await Promise.all(
      names.map(async (name) => ({
        name,
        at: (await stat(join(dir, name)).catch(() => null))?.mtimeMs ?? 0
      }))
    )
    dated.sort((a, b) => a.at - b.at)
    for (const entry of dated.slice(0, dated.length - THUMBNAIL_DISK_MAX)) {
      await rm(join(dir, entry.name), { force: true }).catch(() => {})
    }
  } catch {
    // A cache that could not be trimmed is not a reason to fail a lookup.
  }
}

async function fetchThumbnail(url: string): Promise<string | null> {
  const response = await fetchGuarded(url, {
    signal: AbortSignal.timeout(THUMBNAIL_TIMEOUT_MS),
    headers: { accept: 'image/*', 'user-agent': DEFAULT_USER_AGENT },
    timeoutMs: THUMBNAIL_TIMEOUT_MS
  })
  try {
    if (!response.ok) return null

    const type = (response.headers.get('content-type') ?? '').split(';')[0].trim().toLowerCase()
    // YouTube answers a missing `maxresdefault.jpg` with an HTML 404 page rather
    // than a 404 status, and a document is not an image.
    if (!type.startsWith('image/')) return null

    const bytes = await readResponseBytes(response, THUMBNAIL_MAX_BYTES)
    if (bytes.length === 0) return null

    return `data:${type};base64,${bytes.toString('base64')}`
  } finally {
    await response.body?.cancel().catch(() => {})
  }
}
</file>

<file path="src/main/twitter.ts">
import type { MediaVariant, RequestHeaders, YouTubeResolution } from '../shared/types.ts'
import { xStatusId } from '../shared/x-post.ts'
import { logger } from './log.ts'
import { fetchGuarded } from './fetch-guard.ts'
import { readResponseText } from './response-limit.ts'

const log = logger('twitter')

interface TwitterMediaDetail {
  type?: 'photo' | 'video' | 'animated_gif' | string
  media_url_https?: string
  original_info?: {
    width?: number
    height?: number
  }
  sizes?: {
    large?: { w?: number; h?: number }
    medium?: { w?: number; h?: number }
  }
  video_info?: {
    aspect_ratio?: [number, number]
    duration_millis?: number
    variants?: Array<{
      bitrate?: number
      content_type?: string
      url?: string
    }>
  }
}

interface TwitterTweetResult {
  text?: string
  user?: {
    name?: string
    screen_name?: string
    profile_image_url_https?: string
  }
  mediaDetails?: TwitterMediaDetail[]
  video?: {
    variants?: Array<{
      bitrate?: number
      content_type?: string
      url?: string
    }>
  }
}

/** Computes the verification token required by Twitter's syndication endpoint. */
export function tokenForTweet(id: string): string {
  // Snowflake IDs exceed Number.MAX_SAFE_INTEGER. The syndication token uses
  // JavaScript's floating-point conversion of the decimal ID intentionally.
  if (!/^\d{1,20}$/.test(id)) return ''
  const num = Number(id)
  if (!Number.isFinite(num) || num <= 0) return ''
  return ((num / 1e15) * Math.PI)
    .toString(36)
    .replace(/(0+|\.)/g, '')
}

/**
 * Resolves media from an X (Twitter) post via the syndication endpoint.
 * This directly extracts full-resolution photos, animated GIFs, and videos
 * without depending on external scrapers or authentication.
 */
export async function resolveTwitterPost(
  pageUrl: string,
  headers?: RequestHeaders
): Promise<YouTubeResolution | null> {
  const statusId = xStatusId(pageUrl)
  if (!statusId) return null

  const token = tokenForTweet(statusId)
  if (!token) return null

  const syndicationUrl = `https://cdn.syndication.twimg.com/tweet-result?id=${encodeURIComponent(statusId)}&token=${encodeURIComponent(token)}&lang=en`
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), 15_000)

  try {
    const reqHeaders: Record<string, string> = {
      'user-agent':
        headers?.userAgent ||
        'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36',
      accept: 'application/json'
    }

    const res = await fetchGuarded(syndicationUrl, {
      headers: reqHeaders,
      signal: controller.signal,
      timeoutMs: 15_000,
      requireHttps: true
    })
    if (!res.ok) {
      await res.body?.cancel().catch(() => {})
      log.warn(`syndication endpoint returned HTTP ${res.status} for tweet ${statusId}`)
      return null
    }

    const text = await readResponseText(res, 2 * 1024 * 1024)
    if (!text.startsWith('{')) return null

    const data = JSON.parse(text) as TwitterTweetResult
    const mediaList = data.mediaDetails ?? []
    if (mediaList.length === 0 && !data.video) {
      log.info(`tweet ${statusId} carries no declared media details`)
      return null
    }

    const variants: MediaVariant[] = []
    let primaryThumbnail: string | null = null

    let photoIndex = 1
    let videoIndex = 1

    const hasMultipleItems = mediaList.length > 1

    for (const item of mediaList) {
      if (item.type === 'photo' && item.media_url_https) {
        if (!primaryThumbnail) primaryThumbnail = item.media_url_https
        const width = item.original_info?.width ?? item.sizes?.large?.w ?? null
        const height = item.original_info?.height ?? item.sizes?.large?.h ?? null
        const dimLabel = width && height ? ` (${width}x${height})` : ''
        const photoUrl = item.media_url_https.includes('?')
          ? item.media_url_https
          : `${item.media_url_https}?name=orig`

        const extMatch = /\.([a-z0-9]+)(?:\?|$)/i.exec(item.media_url_https)
        const container = extMatch ? extMatch[1].toLowerCase() : 'jpg'

        variants.push({
          label: hasMultipleItems ? `Photo ${photoIndex++}${dimLabel}` : `Photo${dimLabel}`,
          container,
          url: photoUrl,
          audioUrl: null,
          height,
          bandwidth: null,
          codecs: null,
          estimatedSize: null
        })
      } else if ((item.type === 'video' || item.type === 'animated_gif') && item.video_info?.variants) {
        if (!primaryThumbnail && item.media_url_https) primaryThumbnail = item.media_url_https
        const mp4s = item.video_info.variants
          .filter((v) => v.url && /video\/mp4/i.test(v.content_type ?? ''))
          .sort((a, b) => (b.bitrate ?? 0) - (a.bitrate ?? 0))

        const isGif = item.type === 'animated_gif'
        if (hasMultipleItems && !isGif) {
          const best = mp4s[0]
          if (best?.url) {
            const dimMatch = /\/(\d+)x(\d+)\//.exec(best.url)
            const h = dimMatch ? Number(dimMatch[2]) : null
            const w = dimMatch ? Number(dimMatch[1]) : null
            const resolvedHeight = h && w ? (h > w ? w : h) : h

            const label = `Video ${videoIndex}${resolvedHeight ? ` (${resolvedHeight}p)` : ''}`
            variants.push({
              label,
              container: 'mp4',
              url: best.url,
              audioUrl: null,
              height: resolvedHeight,
              bandwidth: best.bitrate ?? null,
              codecs: 'avc1',
              estimatedSize: null
            })
          }
        } else {
          for (const v of mp4s) {
            if (!v.url) continue
            // Derive height from dimensions in URL (e.g. /720x1280/) or bitrate
            const dimMatch = /\/(\d+)x(\d+)\//.exec(v.url)
            const h = dimMatch ? Number(dimMatch[2]) : null
            const w = dimMatch ? Number(dimMatch[1]) : null
            const resolvedHeight = h && w ? (h > w ? w : h) : h

            const label = isGif
              ? `GIF${dimMatch ? ` (${dimMatch[1]}x${dimMatch[2]})` : ''}`
              : resolvedHeight
                ? `${resolvedHeight}p`
                : v.bitrate
                  ? `${Math.round(v.bitrate / 1000)} kbps`
                  : `Video ${videoIndex}`

            variants.push({
              label,
              container: 'mp4',
              url: v.url,
              audioUrl: null,
              height: resolvedHeight,
              bandwidth: v.bitrate ?? null,
              codecs: 'avc1',
              estimatedSize: null
            })
          }
        }
        videoIndex++
      }
    }

    if (variants.length === 0 && data.video?.variants) {
      const mp4s = data.video.variants
        .filter((v) => v.url && /video\/mp4/i.test(v.content_type ?? ''))
        .sort((a, b) => (b.bitrate ?? 0) - (a.bitrate ?? 0))
      for (const v of mp4s) {
        if (!v.url) continue
        const dimMatch = /\/(\d+)x(\d+)\//.exec(v.url)
        const h = dimMatch ? Number(dimMatch[2]) : null
        const w = dimMatch ? Number(dimMatch[1]) : null
        const resolvedHeight = h && w ? (h > w ? w : h) : h
        const label = resolvedHeight ? `${resolvedHeight}p` : v.bitrate ? `${Math.round(v.bitrate / 1000)} kbps` : 'Video'
        variants.push({
          label,
          container: 'mp4',
          url: v.url,
          audioUrl: null,
          height: resolvedHeight,
          bandwidth: v.bitrate ?? null,
          codecs: 'avc1',
          estimatedSize: null
        })
      }
    }

    if (variants.length === 0) return null

    const userName = data.user?.name || data.user?.screen_name || 'X'
    const tweetSnippet = data.text ? data.text.trim().slice(0, 60).replace(/\s+/g, ' ') : ''
    const title = tweetSnippet ? `${userName}: "${tweetSnippet}"` : `${userName} on X`

    return {
      id: statusId,
      title,
      variants,
      thumbnailUrl: primaryThumbnail
    }
  } catch (err) {
    log.warn(`failed to resolve twitter post ${statusId}: ${String(err)}`)
    return null
  } finally {
    clearTimeout(timer)
  }
}
</file>

<file path="src/main/youtube-runtime.ts">
/**
 * yt-dlp needs a JavaScript runtime for YouTube's player challenges.
 *
 * Electron already ships a sufficiently new Node runtime. Pointing yt-dlp at
 * the running executable and setting ELECTRON_RUN_AS_NODE makes that runtime
 * available in both development and packaged builds without asking the user to
 * install Deno or add Node to PATH.
 */
export function electronNodeRuntimeArgs(executable = process.execPath): string[] {
  return ['--js-runtimes', `node:${executable}`]
}

export function electronNodeRuntimeEnv(
  base: NodeJS.ProcessEnv = process.env
): NodeJS.ProcessEnv {
  return { ...base, ELECTRON_RUN_AS_NODE: '1' }
}
