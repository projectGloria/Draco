<file path="resources/draco.cfg">
# draco.cfg - default options for the `draco` command line.
#
# Write draco flags exactly as you would type them, one or more per line.
# Lines starting with # are comments. Everything here is commented out, so
# draco behaves as built until you remove a # in front of a line.
#
# The command line always wins: with "-N 16" here, `draco URL -N 4` uses 4.
# Run `draco --ignore-config URL` to skip this file for one run, or
# `draco --config-location D:\other.cfg URL` to read another one.
#
# Quotes group words; backslashes are literal, so Windows paths need no
# escaping. Quote a "#" you mean literally, e.g. -f "#3".
#
# This file survives updates. Uninstalling keeps a copy at
# %APPDATA%\Draco\draco.cfg.bak, which a reinstall restores.

# ---- Where files go ---------------------------------------------------------

# Download folder when you start draco from your home folder - where Windows
# Terminal opens - or from System32. Start it from any other folder and it saves
# there instead. Default: your Downloads folder. F2 > Save to can set this line.
# -P "D:\Videos"

# Output template. "/" makes folders; each %(field)s is filled per download.
# Fields: title, ext, id, uploader, upload_date, height, resolution,
#         format_id, playlist, playlist_index. A missing field becomes NA.
# -o "%(uploader)s/%(title)s.%(ext)s"
# -o "%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s"
# -o "%(upload_date)s %(title)s [%(resolution)s].%(ext)s"

# ---- Quality ----------------------------------------------------------------

# best (default), worst, bestaudio, or a height such as 1080 / 720.
# -f 1080

# Audio only, for every download.
# -x

# ---- Network ----------------------------------------------------------------

# Connections per download (1-64, default 8).
# -N 16

# Downloads running at once (1-32, default 3).
# -c 3

# Total speed cap, e.g. 500K, 4M.
# -r 4M

# Retries per failed request (default 5) and stall timeout in seconds (default 30).
# -R 5
# --socket-timeout 30

# HTTP(S) proxy.
# --proxy http://127.0.0.1:8080

# Use a browser's cookies for sites that need a login (yt-dlp).
# chrome, edge, brave, firefox, chromium, opera, vivaldi
# --cookies-from-browser firefox

# ---- Behaviour --------------------------------------------------------------

# For watch?v=...&list=... links, take only that video.
# --no-playlist

# No live progress lines (handy when logging to a file).
# --no-progress

# ---- Optional yt-dlp media processing ----------------------------------------
# These options use yt-dlp for downloading and processing media.
# -S lang,quality,res,fps,hdr:12,vbr,vcodec,channels,abr,acodec
# --merge-output-format mkv
# --write-thumbnail
# --convert-thumbnails png
# --embed-thumbnail
# --embed-metadata
# --embed-chapters
# --windows-filenames
# --no-mtime
</file>

<file path="resources/installer.nsh">
; Custom steps electron-builder splices into the NSIS installer/uninstaller.
;
; Setup puts the `draco` command on the user's PATH; uninstall takes it off.
; Neither touches PATH from NSIS itself: NSIS strings have a fixed size, and a
; long PATH read into one comes back truncated. Draco.exe runs as plain Node
; instead (ELECTRON_RUN_AS_NODE) and executes out/main/path-setup.js, which
; uses the same code as the Options toggle.
;
; It also owns draco.cfg, the CLI's config in the install root. That folder is
; deleted wholesale on every update (the old uninstaller runs first), so the
; user's copy is parked in %APPDATA%\Draco on the way out and put back on the
; way in.

!define DRACO_CFG_BACKUP "$APPDATA\Draco\draco.cfg.bak"

!macro dracoPathSetup ACTION
  ; Child processes inherit the installer's environment, so set the flag only
  ; around this one call. Leaving it set would make the "Run Draco" checkbox at
  ; the end launch Draco.exe as headless Node instead of the app.
  System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "1")'
  nsExec::ExecToLog '"$INSTDIR\${APP_EXECUTABLE_FILENAME}" "$INSTDIR\resources\app.asar\out\main\path-setup.js" ${ACTION} "$INSTDIR\resources\bin"'
  Pop $0
  System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", p 0)'
  ${If} $0 != 0
    ; Not fatal: the app re-syncs PATH on every start.
    DetailPrint "draco PATH ${ACTION} did not complete (exit $0)"
  ${EndIf}
!macroend

!macro customInstall
  !insertmacro dracoPathSetup add

  ; The user's own config wins over the sample: restore the copy the previous
  ; version's uninstaller parked, and write the commented sample only when
  ; there is nothing of theirs to keep.
  ${IfNot} ${FileExists} "$INSTDIR\draco.cfg"
    ${If} ${FileExists} "${DRACO_CFG_BACKUP}"
      CopyFiles /SILENT "${DRACO_CFG_BACKUP}" "$INSTDIR\draco.cfg"
      Delete "${DRACO_CFG_BACKUP}"
      DetailPrint "Restored your draco.cfg"
    ${Else}
      File "/oname=$INSTDIR\draco.cfg" "${BUILD_RESOURCES_DIR}\draco.cfg"
    ${EndIf}
  ${EndIf}
!macroend

; Runs before the files are deleted, so Draco.exe, the script and draco.cfg
; still exist. Also runs when an update replaces this version; the new
; install's customInstall re-adds PATH and restores draco.cfg right after.
!macro customUnInstall
  !insertmacro dracoPathSetup remove

  ${If} ${FileExists} "$INSTDIR\draco.cfg"
    CreateDirectory "$APPDATA\Draco"
    CopyFiles /SILENT "$INSTDIR\draco.cfg" "${DRACO_CFG_BACKUP}"
  ${EndIf}
!macroend
</file>

<file path="src/cli/draco.ts">
/**
 * `draco` - the download engine from a terminal.
 *
 *   draco <url> -best
 *   draco <url> -f 720 -P D:\Videos
 *   draco <url> -F
 *
 * Runs the app's own resolvers and engine, not a reimplementation of them: the
 * same yt-dlp lookup, the same quality ladder, the same segmented runner, the
 * same ffmpeg mux. Only the shell differs. It shares Draco's managed yt-dlp and
 * ffmpeg (%APPDATA%/Draco/bin) and reads its saved settings for defaults, but
 * never its task list - a CLI download does not appear in, or fight with, the
 * GUI's queue.
 *
 * The downloading itself lives in `session.ts`; this file is the shell around
 * it: options, paths, and the two front ends (plain output, full screen).
 *
 * Under bare Node (dev, via `npm link`) this runs as source through type
 * stripping. Packaged, `resources/bin/draco.cmd` runs the bundled copy with
 * Draco.exe in ELECTRON_RUN_AS_NODE mode, so no separate Node is required.
 */
import { homedir } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import pkg from '../../package.json' with { type: 'json' }
import { configurePaths, getPaths } from '../main/bootstrap/paths.ts'
import { normalizeDownloadDirectory } from '../main/destination-path.ts'
import { setTorrentStoreDir } from '../main/engine/torrent-store.ts'
import { flushLogs, setLogConsole, setLogDirectory } from '../main/log.ts'
import { setYtDlpCookieBrowser } from '../main/youtube.ts'
import { configRequest, HELP, parseArgs, UsageError, type CliOptions } from './args.ts'
import { defaultConfigPath, loadConfig } from './config.ts'
import { isTemplate, validateTemplate } from './template.ts'
import { openTerminal, shouldOpenTerminal } from './interactive.ts'
import { friendlyError, painter, transferLines, type Transfer } from './progress.ts'
import { runMediaDownload } from './media-download.ts'
import { resolveSaveDir, saveDirLabel, type SaveDir } from './save-dir.ts'
import { createSession, type Reporter } from './session.ts'
import { acquireTerminal } from './terminal-io.ts'

/* ------------------------------------------------------------------ */
/* Bootstrapping                                                       */
/* ------------------------------------------------------------------ */

/** Repo root in dev; the app root inside the asar when bundled. */
const sourceRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..')

const isPackaged = (): boolean => Boolean(process.versions.electron || process.env.DRACO_CLI_ROOT)

function bootPaths(): void {
  // Running inside Draco.exe (ELECTRON_RUN_AS_NODE) means a packaged install:
  // the bundled yt-dlp/ffmpeg sit under resources/runtime, as for the GUI.
  const packaged = isPackaged()
  const appData = process.env.APPDATA || join(homedir(), 'AppData', 'Roaming')
  configurePaths({
    // Same folder Electron's `userData` resolves to, so the CLI reuses the
    // tools the GUI already downloaded instead of fetching its own copies.
    userData: join(appData, 'Draco'),
    resourceRoot: packaged
      ? process.env.DRACO_CLI_ROOT ? join(process.env.DRACO_CLI_ROOT, 'resources') : process.resourcesPath ?? join(dirname(process.execPath), 'resources')
      : sourceRoot,
    isPackaged: packaged,
    downloads: join(homedir(), 'Downloads')
  })
}

/**
 * The folder the person was in when they started draco. `npm run cli` moves
 * the process to the package root and keeps the real one in INIT_CWD.
 */
function startedIn(): string {
  return process.env.npm_lifecycle_event && process.env.INIT_CWD ? process.env.INIT_CWD : process.cwd()
}

interface LoadedOptions {
  options: CliOptions
  configNote: string
  /** The cfg that was read, if one was. */
  configPath: string | null
  /** The cfg F2 would write to - the one that would be read, even if it does not exist yet. */
  configTarget: string | null
  saveDir: SaveDir
}

/**
 * Reads draco.cfg (unless told not to) and parses it under the command line.
 *
 * The CLI's defaults come from here and from nowhere else - deliberately not
 * from the GUI's settings.json, so what a command does never depends on what
 * someone last clicked in the app's Options.
 */
async function loadOptions(argv: string[]): Promise<LoadedOptions> {
  const request = configRequest(argv)
  const path = request.ignore
    ? null
    : request.location
      ? resolve(request.location)
      : defaultConfigPath(isPackaged(), process.execPath, sourceRoot)
  const tokens = path ? await loadConfig(path, request.location !== null) : null
  let options: CliOptions
  let cfgDir: string | null = null
  try {
    options = parseArgs(argv, tokens ?? [])
    // The cfg's `-P` is a default for "started from nowhere in particular",
    // not an override, so it has to be told apart from a typed one.
    if (tokens) cfgDir = parseArgs([PLACEHOLDER_URL], tokens).dir
  } catch (error) {
    // "draco.cfg: unknown option" alone leaves people hunting for which
    // draco.cfg - the installed one, a dev checkout's, a --config-location one.
    if (error instanceof UsageError && error.message.startsWith('draco.cfg: ')) {
      throw new UsageError(`${error.message.slice(11)} (in ${path})`)
    }
    throw error
  }
  const cliDir = tokens ? parseArgs(argv).dir : options.dir
  const saveDir = resolveSaveDir({
    cliDir,
    cfgDir,
    cwd: startedIn(),
    // Draco's own folder is where the Start-menu shortcut runs it from.
    ignore: isPackaged() ? [dirname(process.execPath)] : []
  })
  return {
    options,
    configNote: request.ignore ? 'Settings file ignored (--ignore-config)' : tokens ? `Using settings from ${path}` : `No settings file at ${path}`,
    configPath: tokens ? path : null,
    configTarget: path,
    saveDir
  }
}

/* ------------------------------------------------------------------ */
/* Output                                                              */
/* ------------------------------------------------------------------ */

/**
 * Permanent lines scroll; live progress (a card per active download, or one
 * "what is happening" line while resolving) is redrawn in place underneath.
 *
 * Live drawing only happens on a real terminal. Piped into a file or another
 * program, the same run prints just the permanent lines, so logs stay
 * greppable instead of filling with cursor escapes.
 *
 * The full-screen UI does not come through here: it is a `Reporter` of its own.
 */
class Status implements Reporter {
  private transfers: Transfer[] = []
  private drawn = 0
  private message: string | null = null
  // Plain fields, not constructor parameter properties: those are not erasable
  // syntax, and Node's strip-only type stripping refuses to load the file.
  private readonly interactive: boolean
  private readonly quiet: boolean
  private readonly paint = painter(Boolean(process.stdout.isTTY) && !('NO_COLOR' in process.env))

  constructor(interactive: boolean, quiet: boolean) {
    this.interactive = interactive
    this.quiet = quiet
  }

  set(message: string | null): void {
    this.message = message
    if (this.interactive) this.redraw()
  }

  info(line: string): void {
    if (!this.quiet) this.print(process.stdout, line)
  }

  error(line: string): void {
    this.print(process.stderr, line)
  }

  saved(_path: string, line: string): void {
    this.info(line)
  }

  progress(transfers: Transfer[]): void {
    // The session ticks every 250 ms; an empty tick on an empty screen is no news.
    if (transfers.length === 0 && this.transfers.length === 0) return
    this.transfers = transfers
    if (this.interactive) this.redraw()
  }

  clear(): void {
    this.transfers = []
    this.message = null
    if (this.interactive) this.redraw()
  }

  private print(stream: NodeJS.WriteStream, line: string): void {
    this.erase()
    stream.write(line + '\n')
    if (this.interactive) this.redraw()
  }

  private erase(): void {
    if (this.drawn > 0) process.stdout.write(`\x1b[${this.drawn}A\x1b[0J`)
    this.drawn = 0
  }

  private redraw(): void {
    this.erase()
    // Fitted one column short of the edge: a line that exactly fills the last
    // column wraps on some consoles, and the cursor-up count would then leave
    // stale fragments behind. Capped at 100 so the bar stays readable.
    const width = Math.max(20, Math.min(100, (process.stdout.columns || 100) - 1))
    const lines = this.transfers.flatMap((t) => transferLines(t, width, this.paint))
    if (this.message && lines.length === 0) lines.push(this.message.length > width ? this.message.slice(0, width - 1) + '…' : this.message)
    if (lines.length === 0) return
    process.stdout.write(lines.join('\n') + '\n')
    this.drawn = lines.length
  }
}

/* ------------------------------------------------------------------ */
/* Main                                                                */
/* ------------------------------------------------------------------ */

/** Process-wide engine wiring: logs, torrent state, yt-dlp cookies. */
function bootEngine(options: CliOptions): void {
  const paths = getPaths()
  setLogConsole(options.verbose)
  // Its own file: the GUI may be appending to logs/main.log right now, and two
  // processes rolling the same file over would lose lines from both.
  setLogDirectory(join(paths.logs, 'cli'))
  setTorrentStoreDir(paths.torrents)
  const cookieBrowser = options.cookiesFromBrowser ?? 'none'
  setYtDlpCookieBrowser(() => cookieBrowser)
}

/** Stands in for a URL when parsing options for the full-screen UI, which has none yet. */
const PLACEHOLDER_URL = 'https://draco.invalid/'

export async function main(argv: string[]): Promise<number> {
  const terminal = argv.length === 0 ? acquireTerminal() : null
  if (terminal && shouldOpenTerminal(argv, true, true)) {
    // Parse config with a placeholder URL only to obtain defaults. No network
    // request is made until the user submits a link in the terminal.
    try {
      const { options, saveDir, configPath, configTarget } = await loadOptions([PLACEHOLDER_URL])
      bootPaths()
      bootEngine(options)
      // The UI always downloads; inspection flags stay available to ordinary
      // invocations even when draco.cfg sets them as defaults.
      Object.assign(options, { quiet: false, noProgress: false, listFormats: false, getUrl: false, help: false, version: false })
      return await openTerminal({
        version: pkg.version,
        preferencePath: join(getPaths().root, 'cli-preferences.json'),
        defaults: { format: options.format, dir: saveDir.dir, dirSource: saveDir.source },
        config: configPath,
        configTarget,
        // One lane by default: a queue, one download at a time, the next
        // starting as soon as the current one is merging.
        openSession: (reporter, choose) => createSession({ options, dir: saveDir.dir, reporter, choose, lanes: options.concurrent ?? 1 }),
        terminal
      })
    } catch (error) {
      process.stderr.write(`draco: ${(error as Error).message}\n`)
      return 2
    } finally {
      terminal.close()
    }
  }
  terminal?.close()
  let options: CliOptions
  let configNote: string
  let saveDir: SaveDir
  try {
    ;({ options, configNote, saveDir } = await loadOptions(argv))
    // A broken template is a typo in the command (or draco.cfg); refuse it
    // before anything is resolved, not once per URL halfway through a run.
    if (options.output && isTemplate(options.output)) {
      try {
        validateTemplate(options.output)
      } catch (error) {
        throw new UsageError((error as Error).message)
      }
    }
  } catch (error) {
    if (error instanceof UsageError) {
      process.stderr.write(`draco: ${error.message}\nTry 'draco --help'.\n`)
      return 2
    }
    throw error
  }
  if (options.help) {
    process.stdout.write(HELP + '\n')
    return 0
  }
  if (options.version) {
    process.stdout.write(`draco ${pkg.version}\n`)
    return 0
  }

  bootPaths()
  bootEngine(options)
  const interactive = Boolean(process.stdout.isTTY) && !options.noProgress && !options.quiet
  const dir = normalizeDownloadDirectory(saveDir.dir)

  if (Object.keys(options.mediaOptions).length > 0) {
    const status = new Status(interactive, options.quiet)
    try { return await runMediaDownload({ ...options, dir }, status) }
    catch (error) { status.error(`Could not download: ${friendlyError((error as Error).message)}`); return 1 }
    finally { status.clear(); await flushLogs() }
  }

  const status = new Status(interactive, options.quiet)
  if (options.verbose) status.info(configNote)
  if (options.verbose && saveDir.source !== 'typed') status.info(`Saving to ${dir} (${saveDirLabel(saveDir.source)})`)
  // Several URLs on one command line still download side by side; a
  // playlist's entries run in order whatever this says.
  const session = createSession({ options, dir, reporter: status, lanes: options.concurrent ?? 3 })

  // Ctrl-C pauses rather than aborts: the runners flush their journals, so the
  // same command picks up where this one stopped. A second Ctrl-C is the
  // "I mean it" exit, for when a flush itself is what is stuck.
  let stopping = false
  const onInterrupt = (): void => {
    if (stopping) process.exit(130)
    stopping = true
    status.clear()
    status.error('Pausing and saving progress… (press Ctrl+C again to quit right away)')
    void session.close().finally(() => {
      status.error('Paused. Run the same command again to pick up where it stopped.')
      process.exit(130)
    })
  }
  process.on('SIGINT', onInterrupt)

  // Resolve one URL at a time and hand each result to the engine immediately:
  // the first video downloads while the second is still being looked up, and a
  // playlist starts after one lookup rather than after all of them.
  try {
    for (const input of options.urls) {
      if (stopping) break
      // Failures are reported by the session and counted in `failures`.
      await session.submit(input).catch(() => {})
    }
    await session.idle()
  } finally {
    process.removeListener('SIGINT', onInterrupt)
    if (!stopping) await session.close()
  }
  return stopping ? 130 : session.failures > 0 ? 1 : 0
}
</file>

<file path="src/cli/interactive.ts">
import { spawn } from 'node:child_process'
import { existsSync } from 'node:fs'
import { mkdir } from 'node:fs/promises'
import { emitKeypressEvents } from 'node:readline'
import { dirname, resolve } from 'node:path'
import { validateUrl } from '../main/engine/create.ts'
import type { MediaVariant } from '../shared/types.ts'
import { isAudioVariant, type FormatSpec } from './args.ts'
import { setConfigDir } from './config.ts'
import { formatLabel, readPreferences, writePreferences, type Preferences, type SavedFormat } from './preferences.ts'
import type { Transfer } from './progress.ts'
import type { SaveDirSource } from './save-dir.ts'
import { CancelledError, type QueueItem, type Reporter, type Session } from './session.ts'
import { renderTerminal, type Note, type TerminalView } from './terminal-view.ts'
import { cleanText } from './text.ts'

export type Choose = (variants: MediaVariant[], title: string, configured: FormatSpec) => Promise<FormatSpec>

/** Desktop integration, injectable so tests never launch Explorer. */
export interface Shell {
  /** Shows `file` selected in its folder, or opens `dir` when there is no file yet. */
  reveal: (target: { dir: string; file: string | null }) => Promise<void>
  /** Opens a file with its default app. */
  open: (file: string) => Promise<void>
}

export interface InteractiveDependencies {
  version: string
  preferencePath: string
  defaults: { format: FormatSpec; dir: string; dirSource?: SaveDirSource }
  /** Opens the one download session the screen feeds for its whole lifetime. */
  openSession: (reporter: Reporter, choose: Choose) => Session
  /** The draco.cfg in effect, shown in the header so its options are never a surprise. */
  config?: string | null
  /** Where F2 writes a new default folder; null when draco.cfg is ignored. */
  configTarget?: string | null
  shell?: Shell
  terminal?: { input: NodeJS.ReadStream; output: NodeJS.WriteStream }
  /** Taskbar progress (OSC 9;4). Defaults to on in terminals known to draw it. */
  taskbar?: boolean
}

export function shouldOpenTerminal(argv: string[], stdinTTY: boolean, stdoutTTY: boolean,
  platform: string = process.platform, term = process.env.TERM): boolean {
  // Native Windows consoles support VT regardless of an inherited TERM=dumb.
  return argv.length === 0 && stdinTTY && stdoutTTY && (platform === 'win32' || term !== 'dumb')
}

export function qualityChoices(variants?: MediaVariant[]): SavedFormat[] {
  if (!variants) return [{ kind: 'best' }, ...[2160, 1440, 1080, 720, 480, 360].map(height =>
    ({ kind: 'height', height }) as SavedFormat), { kind: 'bestaudio' }, { kind: 'worst' }]
  const choices: SavedFormat[] = [{ kind: 'best' }]
  const heights = [...new Set(variants.filter(v => !isAudioVariant(v)).map(v => v.height).filter((h): h is number => !!h))]
  heights.sort((a, b) => b - a).forEach(height => choices.push({ kind: 'height', height }))
  if (variants.some(isAudioVariant)) choices.push({ kind: 'bestaudio' })
  return choices
}

/**
 * Starts a desktop helper and resolves once it has launched - not when it
 * exits: explorer.exe returns 1 on success and lingers, so its exit code says
 * nothing useful.
 */
function launch(command: string, args: string[], verbatim = false): Promise<void> {
  return new Promise((done, reject) => {
    const child = spawn(command, args, { windowsHide: true, detached: true, stdio: 'ignore', windowsVerbatimArguments: verbatim })
    child.once('error', reject)
    child.once('spawn', () => { child.unref(); done() })
  })
}

export const desktopShell: Shell = {
  async reveal({ dir, file }) {
    if (file && existsSync(file)) {
      // `/select,"path"` must reach Explorer exactly like this; Node's own
      // quoting would wrap the whole argument and Explorer would open Documents.
      // Windows paths cannot contain `"`, so the verbatim string is safe.
      if (process.platform === 'win32') return launch('explorer.exe', [`/select,"${file}"`], true)
      if (process.platform === 'darwin') return launch('open', ['-R', file])
      return launch('xdg-open', [dirname(file)])
    }
    await mkdir(dir, { recursive: true })
    return launch(process.platform === 'win32' ? 'explorer.exe' : process.platform === 'darwin' ? 'open' : 'xdg-open', [dir])
  },
  async open(file) {
    // Explorer given a file opens it with the associated app, with no shell in
    // between - a title containing `&` cannot turn into a second command.
    return launch(process.platform === 'win32' ? 'explorer.exe' : process.platform === 'darwin' ? 'open' : 'xdg-open', [file])
  }
}

/** Splits pasted text into candidate links: one per line or per space-separated word. */
export function splitLinks(text: string): string[] {
  return text.split(/\s+/).map(part => part.trim()).filter(Boolean)
}

/** Windows Terminal and ConEmu draw OSC 9;4 as tab and taskbar progress; others may print it. */
function taskbarSupported(): boolean {
  return Boolean(process.env.WT_SESSION || process.env.ConEmuPID)
}

export async function openTerminal(deps: InteractiveDependencies): Promise<number> {
  const input = deps.terminal?.input ?? process.stdin, output = deps.terminal?.output ?? process.stdout
  const shell = deps.shell ?? desktopShell
  const taskbar = deps.taskbar ?? taskbarSupported()
  let preferences: Preferences = {}
  const startup: Note[] = []
  try { preferences = await readPreferences(deps.preferencePath) }
  catch { startup.push({ text: 'Could not read saved preferences. Using the defaults.', tone: 'bad' }) }
  // A folder saved by older versions would override "download where I opened
  // Draco" forever; the default folder lives in draco.cfg now. Dropped on the next save.
  delete preferences.dir
  const state: TerminalView = {
    version: deps.version, input: '', cursor: 0,
    format: preferences.format ?? deps.defaults.format,
    dir: deps.defaults.dir, dirSource: deps.defaults.dirSource, busy: false,
    notes: startup, activity: null, transfers: [], queue: [], lastSaved: null, config: deps.config ?? null
  }
  const colors = !('NO_COLOR' in process.env) && process.env.FORCE_COLOR !== '0'
  let closed = false
  let picker: ((choice: number | null) => void) | null = null
  let saving: Promise<void> = Promise.resolve()
  let pasting = false, pasted = '', savedInput = ''
  // Links submitted this session, newest last; ↑/↓ walk it like a shell history.
  const history: string[] = []
  let historyAt = 0, draft = ''
  let lastUrl: string | null = null
  let redrawTimer: ReturnType<typeof setTimeout> | undefined
  let resizeTimer: ReturnType<typeof setTimeout> | undefined
  let sizeTimer: ReturnType<typeof setInterval> | undefined
  let dimensions = ''
  // One "round" is from the first link to the queue running dry; at its end the
  // bell rings if it was worth waiting for.
  let round: { started: number; saved: number } | null = null
  let taskbarState = ''
  let finish!: () => void
  const ended = new Promise<void>(done => { finish = done })
  const wasRaw = input.isRaw

  const reporter: Reporter = {
    set(message) { state.activity = message ? cleanText(message) : null; schedule() },
    info(line) { note(line) },
    error(line) { note(line, 'bad') },
    saved(path, message) {
      state.lastSaved = path
      if (round) round.saved++
      // One hint, kept last: a playlist saving 40 files should not print it 40 times.
      const hint = `F3 opens it · F4 shows it in ${process.platform === 'win32' ? 'Explorer' : 'its folder'}`
      state.notes = state.notes.filter(n => n.text !== hint)
      note(message, 'good')
      note(hint)
    },
    progress(transfers: Transfer[]) {
      // The session ticks every 250 ms; an idle tick changes nothing on screen.
      if (!transfers.length && !state.transfers.length) return
      state.transfers = transfers
      schedule()
    },
    queue(items: QueueItem[]) {
      state.queue = items.map(({ id, title }) => ({ id, title: cleanText(title) }))
      if (state.queueFocus !== undefined) {
        if (!state.queue.length) state.queueFocus = undefined
        else state.queueFocus = Math.min(state.queueFocus, state.queue.length - 1)
      }
      schedule()
    },
    clear() { state.transfers = []; state.activity = null; schedule() }
  }
  const session = deps.openSession(reporter, choose)

  /** Busy = anything resolving, moving, merging or waiting. Derived, never stored by hand. */
  function refresh(): void {
    const c = session.counts()
    const busy = c.transferring + c.finishing + c.waiting + c.resolving > 0
    state.counts = { transferring: c.transferring, finishing: c.finishing, waiting: c.waiting }
    state.paused = session.paused
    if (busy && !round) round = { started: Date.now(), saved: 0 }
    if (!busy && round && !session.paused) {
      // The queue ran dry. Ring once if it took a while or saved several files -
      // the case where someone switched to another window to wait.
      if (round.saved >= 2 || (round.saved >= 1 && Date.now() - round.started > 60_000)) output.write('\x07')
      round = null
    }
    state.busy = busy
  }

  function draw(): void {
    if (closed) return
    refresh()
    const view = renderTerminal(state, output.columns || 100, output.rows || 30, colors)
    output.write('\x1b[?25l' + view.output + progressSequence())
    if (view.cursor) output.write(`\x1b[${view.cursor.row};${view.cursor.column}H\x1b[?25h`)
  }
  /** Windows Terminal's tab/taskbar progress, written only when it changes. */
  function progressSequence(): string {
    if (!taskbar) return ''
    const live = state.transfers.filter(t => t.phase === 'downloading' && t.total)
    const received = live.reduce((sum, t) => sum + (t.received ?? 0), 0)
    const total = live.reduce((sum, t) => sum + (t.total ?? 0), 0)
    const next = !state.busy ? '0;0'
      : state.paused ? `4;${total ? Math.floor(received / total * 100) : 0}`
        : total ? `1;${Math.min(100, Math.floor(received / total * 100))}` : '3;0'
    if (next === taskbarState) return ''
    taskbarState = next
    return `\x1b]9;4;${next}\x07`
  }
  // Coalesces bursts (a progress line every 250 ms, a paste of 500 keypresses)
  // into one repaint per frame.
  function schedule(): void {
    if (!redrawTimer) redrawTimer = setTimeout(() => { redrawTimer = undefined; draw() }, 16)
  }
  function resize(): void {
    if (closed) return
    // ConPTY can finish clearing/reflowing after the initial resize event.
    // Repaint immediately and again once the resize has settled.
    output.write('\x1b[0m\x1b[2J')
    draw()
    if (resizeTimer) clearTimeout(resizeTimer)
    resizeTimer = setTimeout(draw, 120)
  }
  function checkSize(): void {
    // On Windows, Node may not refresh its cached TTY size until input arrives.
    const tty = output as NodeJS.WriteStream & { _refreshSize?: () => void }
    tty._refreshSize?.()
    const next = `${output.columns}:${output.rows}`
    if (next !== dimensions) { dimensions = next; resize() }
    // The spinner and the indeterminate bar animate off the clock, so a busy
    // screen needs frames even when no new numbers arrive.
    else if (state.busy || round) schedule()
  }
  function note(text: string, tone: Note['tone'] = 'info'): void {
    state.notes = [...state.notes, { text: cleanText(text), tone }].slice(-6)
    schedule()
  }
  function save(): Promise<void> {
    const snapshot = { ...preferences }
    saving = saving.then(() => writePreferences(deps.preferencePath, snapshot))
      .catch(() => { note('Could not save preferences; your choices apply until you close Draco.', 'bad') })
    return saving
  }
  function select(title: string, items: string[], selected = 0): Promise<number | null> {
    // A second panel replaces the first; the first one's caller hears "cancelled".
    if (picker) settle(null)
    state.help = false
    state.queueFocus = undefined
    state.panel = { title: cleanText(title), items, selected: Math.max(0, selected) }
    draw()
    return new Promise(done => { picker = done })
  }
  function settle(choice: number | null): void {
    const done = picker
    picker = null
    state.panel = undefined
    done?.(choice)
    schedule()
  }
  async function choose(variants: MediaVariant[], title: string, configured: FormatSpec): Promise<FormatSpec> {
    if (preferences.format) return preferences.format
    const choices = qualityChoices(variants)
    const initial = choices.findIndex(f => formatLabel(f) === formatLabel(configured))
    const index = await select(`Choose a quality for ${title}`, choices.map(formatLabel), initial)
    if (index === null) throw new CancelledError()
    // A prefetch may have asked the same question while this one was open.
    if (preferences.format) return preferences.format
    preferences.format = choices[index]
    state.format = preferences.format
    note(`Quality set to ${formatLabel(preferences.format)}. Change it any time with F2.`)
    await save()
    return preferences.format
  }
  async function settings(): Promise<void> {
    const index = await select('Settings', [`Quality     ${formatLabel(state.format)}`, `Save to     ${state.dir}`])
    if (index === 0) {
      const choices = qualityChoices()
      const selected = await select('Default quality', choices.map(formatLabel), choices.findIndex(f => formatLabel(f) === formatLabel(state.format)))
      if (selected !== null) {
        preferences.format = choices[selected]
        state.format = preferences.format
        await save()
      }
    } else if (index === 1) {
      savedInput = state.input
      setInput(state.dir)
      state.editingDir = true
    }
    schedule()
  }
  /** After a new folder is typed: this session only, or the default in draco.cfg. */
  async function applyDir(dir: string): Promise<void> {
    const options = ['Just for this session']
    if (deps.configTarget) options.push('Make it the default (saved in draco.cfg)')
    const choice = options.length > 1 ? await select(`Save to ${dir}`, options) : 0
    if (choice === null) return
    state.dir = dir
    if (choice === 0) {
      state.dirSource = 'session'
      note(`Saving to ${dir} until you close Draco.`)
    } else {
      state.dirSource = 'config'
      try {
        await setConfigDir(deps.configTarget!, dir)
        state.config = deps.configTarget!
        note(`Saving to ${dir}. Draco uses it whenever you start it from your home folder.`)
      } catch {
        note(`Could not write ${deps.configTarget}. Saving to ${dir} for this session; add -P "${dir}" to that file to keep it.`, 'bad')
      }
    }
    schedule()
  }
  function setInput(text: string): void {
    state.input = text
    state.cursor = Array.from(text).length
  }
  function insert(text: string): void {
    const chars = Array.from(state.input)
    const added = Array.from(cleanText(text))
    // Bound pasted input, keeping render cost predictable.
    if (chars.length + added.length > 32768) { note('That is too long to be a link.', 'bad'); return }
    chars.splice(state.cursor, 0, ...added)
    state.input = chars.join('')
    state.cursor += added.length
    schedule()
  }
  function recall(step: -1 | 1): void {
    if (!history.length) return
    if (historyAt === history.length) draft = state.input
    historyAt = Math.max(0, Math.min(history.length, historyAt + step))
    setInput(historyAt === history.length ? draft : history[historyAt])
  }
  /**
   * Ctrl+C: closes a picker; otherwise pauses what is downloading (keeping the
   * queue); otherwise quits. So the first press never loses anything.
   */
  function stop(): void {
    if (state.panel) { settle(null); return }
    refresh()
    if (state.busy && !session.paused) {
      void session.pause().then(() => {
        const waiting = session.counts().waiting
        note(`Paused${waiting ? ` · ${waiting} waiting` : ''}. F5 continues · Ctrl+C again quits.`)
      })
      note('Pausing and saving progress…')
      return
    }
    finish()
  }
  function reveal(): void {
    const target = { dir: state.lastSaved ? dirname(state.lastSaved) : state.dir, file: state.lastSaved ?? null }
    shell.reveal(target).catch(() => note('Could not open the folder. Check the destination in F2 Settings.', 'bad'))
  }
  function openLast(): void {
    if (!state.lastSaved) { note('Nothing downloaded yet. F3 opens your last download once it is saved.'); return }
    shell.open(state.lastSaved).catch(() => note('Could not open the file. Press F4 to find it in its folder.', 'bad'))
  }
  function submit(): void {
    if (state.editingDir) {
      if (!state.input.trim()) { note('Type a folder to save into.', 'bad'); return }
      const dir = resolve(state.input.trim())
      state.editingDir = false
      setInput(savedInput)
      void applyDir(dir)
      schedule()
      return
    }
    // Several links pasted at once queue one after another, in paste order.
    const links: string[] = []
    for (const part of splitLinks(state.input)) {
      try { links.push(validateUrl(part)) }
      catch (error) { note(`${part.length > 60 ? part.slice(0, 59) + '…' : part}: ${(error as Error).message}`, 'bad') }
    }
    if (!links.length) return
    setInput('')
    historyAt = history.length
    for (const url of links) start(url)
  }
  function start(url: string): void {
    lastUrl = url
    if (history[history.length - 1] !== url) history.push(url)
    historyAt = history.length
    state.help = false
    // Resuming is implied: a new link while paused would otherwise sit there silently.
    if (session.paused) session.resume()
    if (!state.busy) state.notes = []
    state.busy = true
    // Errors were already reported by the session; the promise only says "queued".
    session.submit(url, state.dir).catch(() => { note('Press F5 to try again.') }).finally(schedule)
    schedule()
  }

  function onKey(text: string | undefined, key: { name?: string; ctrl?: boolean; meta?: boolean; sequence?: string }): void {
    if (closed) return
    if (key.sequence === '\x1b[200~') { pasting = true; pasted = ''; return }
    if (key.sequence === '\x1b[201~') {
      pasting = false
      // Line breaks become spaces, so a pasted list of links stays a list.
      if (!state.panel) insert(pasted.replace(/[\r\n]+/g, ' ').trim())
      pasted = ''; return
    }
    if (pasting) { if (pasted.length < 32768) pasted += text ?? ''; return }
    if (key.ctrl && key.name === 'c') { stop(); return }
    // Available in every state, mid-download included.
    if (key.name === 'f1') { state.help = !state.help && !state.panel; schedule(); return }
    if (key.name === 'f3') { openLast(); return }
    if (key.name === 'f4') { reveal(); return }
    if (state.panel) {
      if (key.name === 'up') state.panel.selected = Math.max(0, state.panel.selected - 1)
      if (key.name === 'down') state.panel.selected = Math.min(state.panel.items.length - 1, state.panel.selected + 1)
      if (key.name === 'return') settle(state.panel.selected)
      if (key.name === 'escape') settle(null)
      schedule(); return
    }
    if (key.name === 'escape' && state.help) { state.help = false; schedule(); return }
    if (state.queueFocus !== undefined) {
      // Editing the "Up next" list: ↑/↓ choose, Del removes, anything else goes back to the link box.
      const focus = state.queueFocus, queue = state.queue ?? []
      if (key.name === 'up') state.queueFocus = focus === 0 ? undefined : focus - 1
      else if (key.name === 'down') state.queueFocus = Math.min(queue.length - 1, focus + 1)
      else if (key.name === 'delete' || key.name === 'backspace') {
        const item = queue[focus]
        if (item && session.remove(item.id)) note(`Removed ${item.title} from the queue.`)
      } else {
        state.queueFocus = undefined
        if (key.name !== 'escape') onKey(text, key)
      }
      schedule(); return
    }
    if (key.name === 'f2' && !state.editingDir) { void settings(); return }
    if (key.name === 'f5' && !state.editingDir) {
      if (session.resume()) note('Continuing…')
      else if (lastUrl) start(lastUrl)
      else note('No link to retry yet.')
      schedule(); return
    }
    if (key.name === 'escape') {
      if (state.editingDir) { state.editingDir = false; setInput(savedInput) }
      else { setInput(''); historyAt = history.length }
    } else if (key.name === 'return') submit()
    else if (key.name === 'up' && !state.editingDir) recall(-1)
    else if (key.name === 'down' && !state.editingDir) {
      // Past the newest link, ↓ steps into the queue - only from an empty box,
      // so it never swallows a link being typed.
      if (historyAt === history.length && !state.input && state.queue?.length) state.queueFocus = 0
      else recall(1)
    }
    else if (key.name === 'left') state.cursor = Math.max(0, state.cursor - 1)
    else if (key.name === 'right') state.cursor = Math.min(Array.from(state.input).length, state.cursor + 1)
    else if (key.name === 'home' || (key.ctrl && key.name === 'a')) state.cursor = 0
    else if (key.name === 'end' || (key.ctrl && key.name === 'e')) state.cursor = Array.from(state.input).length
    else if (key.ctrl && key.name === 'u') setInput('')
    else if (key.name === 'backspace' || key.name === 'delete') {
      const chars = Array.from(state.input)
      if (key.name === 'delete') chars.splice(state.cursor, 1)
      else if (state.cursor > 0) chars.splice(--state.cursor, 1)
      state.input = chars.join('')
    } else if (text && !key.ctrl && !key.meta && !text.startsWith('\x1b')) insert(text)
    schedule()
  }
  function restore(): void {
    if (closed) return
    closed = true
    if (redrawTimer) clearTimeout(redrawTimer)
    if (resizeTimer) clearTimeout(resizeTimer)
    if (sizeTimer) clearInterval(sizeTimer)
    input.removeListener('keypress', onKey)
    input.removeListener('end', terminate)
    output.removeListener('resize', resize)
    process.removeListener('SIGINT', stop)
    process.removeListener('SIGTERM', terminate)
    process.removeListener('exit', restore)
    input.setRawMode(wasRaw)
    input.pause()
    output.write((taskbar ? '\x1b]9;4;0;0\x07' : '') + '\x1b[?2004l\x1b[0m\x1b[?25h\x1b[?1049l')
  }
  function terminate(): void { settle(null); finish() }
  try {
    emitKeypressEvents(input)
    input.setRawMode(true)
    input.resume()
    input.on('keypress', onKey)
    input.on('end', terminate)
    output.on('resize', resize)
    dimensions = `${output.columns}:${output.rows}`
    sizeTimer = setInterval(checkSize, 120)
    process.on('SIGINT', stop)
    process.on('SIGTERM', terminate)
    process.on('exit', restore)
    output.write('\x1b[?1049h\x1b[?2004h\x1b[2J')
    draw()
    await ended
    // Pauses whatever is still running - journals flushed, so the same link
    // resumes next time - and cleans up the engine.
    await session.close()
    await saving
    return 0
  } finally { restore() }
}
</file>

<file path="src/cli/media-download.ts">
import { spawn } from 'node:child_process'
import { statSync } from 'node:fs'
import { createInterface } from 'node:readline'
import { basename, resolve } from 'node:path'
import { ensureYtDlp } from '../main/youtube.ts'
import { ensureFfmpeg } from '../main/hls/ffmpeg.ts'
import { electronNodeRuntimeArgs, electronNodeRuntimeEnv } from '../main/youtube-runtime.ts'
import { killTree } from '../main/proc.ts'
import { validateUrl } from '../main/engine/create.ts'
import type { CliOptions } from './args.ts'
import { formatBytes, friendlyError, stepName, transfer, type Transfer } from './progress.ts'
import { cleanText } from './text.ts'

interface Status {
  set(message: string | null): void
  info(message: string): void
  error(message: string): void
  progress(transfers: Transfer[]): void
  saved(path: string, message: string): void
}

/**
 * yt-dlp is asked for machine-readable lines instead of its human output:
 * raw byte counts (so the bar can be drawn at any width) and postprocessor
 * keys (so "Merger" can become "Merging video and audio"). Everything else it
 * prints is hidden unless --verbose, because "[youtube] jNQX: Downloading
 * android player API JSON" means nothing to the person waiting.
 *
 * Fields are `|`-separated; the title goes last on its line, so a `|` inside
 * a title cannot shift the others.
 */
export const MEDIA_PROGRESS_ARGS = [
  '--newline', '--progress', '--progress-delta', '0.25',
  '--print', 'before_dl:DRACO_ITEM:%(playlist_index|)s|%(n_entries|)s|%(format_id)s|%(title)s',
  '--print', 'after_move:DRACO_DONE:%(filepath)s',
  '--progress-template', 'download:DRACO_PROGRESS:%(info.format_id)s|%(info.vcodec)s|%(progress.downloaded_bytes)s|%(progress.total_bytes)s|%(progress.total_bytes_estimate)s|%(progress.speed)s|%(progress.eta)s',
  '--progress-template', 'postprocess:DRACO_STEP:%(progress.postprocessor)s|%(progress.status)s'
]

const number = (value: string | undefined): number | null => {
  const n = Number(value)
  return value && value !== 'NA' && Number.isFinite(n) ? n : null
}

/**
 * Folds yt-dlp's machine lines into the one `Transfer` the screen shows.
 * Pure state + a line in, so it is testable without spawning anything.
 */
export class MediaProgress {
  current: Transfer = transfer('media', 'Your download', 'preparing', { step: 'Getting download details' })
  private parts: string[] = []
  private downloaded = false

  /** Returns what the line meant, for the caller to report. */
  receive(line: string): { kind: 'progress' } | { kind: 'done'; path: string } | null {
    if (line.startsWith('DRACO_ITEM:')) {
      const [index, count, formats, ...title] = line.slice(11).split('|')
      this.parts = formats ? formats.split('+') : []
      this.downloaded = false
      const item = number(index) && number(count) && number(count)! > 1 ? ` (${index} of ${count})` : ''
      this.current = transfer('media', (title.join('|') || 'Your download') + item, 'preparing', { step: 'Starting' })
      return { kind: 'progress' }
    }
    if (line.startsWith('DRACO_PROGRESS:')) {
      const [formatId, vcodec, received, total, estimate, speed, eta] = line.slice(15).split('|')
      const index = this.parts.indexOf(formatId)
      const parts = this.parts.length > 1 ? this.parts.length : null
      this.downloaded = true
      this.current = {
        ...this.current, phase: 'downloading',
        // vcodec "none" is the audio half of a merged download.
        step: parts ? (vcodec === 'none' ? 'Audio' : 'Video') : null,
        part: parts && index >= 0 ? index + 1 : null, parts,
        received: number(received), total: number(total) ?? number(estimate),
        speed: number(speed), eta: number(eta)
      }
      return { kind: 'progress' }
    }
    if (line.startsWith('DRACO_STEP:')) {
      const [key, state] = line.slice(11).split('|')
      if (state !== 'started') return null
      // Thumbnail conversion runs before the download starts; that is still
      // "getting ready", not "finishing".
      this.current = { ...this.current, phase: this.downloaded ? 'finishing' : 'preparing', step: stepName(key),
        part: null, parts: null, speed: null, eta: null }
      return { kind: 'progress' }
    }
    if (line.startsWith('DRACO_DONE:')) {
      return { kind: 'done', path: line.slice(11) }
    }
    return null
  }
}

export function mediaArguments(options: CliOptions): string[] {
  if (options.format.kind === 'index') throw new Error('Use a quality such as 1080 or best with media config options.')
  const format = options.format.kind === 'height' ? `bv*[height<=${options.format.height}]+ba/b[height<=${options.format.height}]`
    : options.format.kind === 'bestaudio' ? 'ba' : options.format.kind === 'worst' ? 'worst' : 'bv*+ba/b'
  const args = ['--ignore-config', '-f', format, '-P', resolve(options.dir ?? process.cwd())]
  for (const [flag, value] of Object.entries(options.mediaOptions)) {
    args.push(flag)
    if (value !== true) args.push(value)
  }
  if (options.output) args.push('-o', options.output)
  if (options.cookiesFromBrowser && options.cookiesFromBrowser !== 'none') args.push('--cookies-from-browser', options.cookiesFromBrowser)
  if (options.noPlaylist) args.push('--no-playlist')
  if (options.force) args.push('--force-overwrites')
  if (options.proxy) args.push('--proxy', options.proxy)
  if (options.rateLimit) args.push('--limit-rate', String(options.rateLimit))
  if (options.retries !== null) args.push('--retries', String(options.retries))
  if (options.socketTimeout !== null) args.push('--socket-timeout', String(options.socketTimeout))
  if (options.connections !== null) args.push('--concurrent-fragments', String(options.connections))
  if (options.listFormats) args.push('--list-formats')
  if (options.getUrl) args.push('--get-url')
  return args
}

export async function runMediaDownload(options: CliOptions, status: Status, signal?: AbortSignal): Promise<number> {
  const controller = new AbortController()
  const abort = (): void => controller.abort()
  signal?.addEventListener('abort', abort, { once: true })
  if (!signal) process.on('SIGINT', abort)
  if (signal?.aborted) abort()
  try {
    status.set('Preparing your download…')
    const args = mediaArguments(options)
    const urls = options.urls.map(url => validateUrl(url))
    const executable = await ensureYtDlp()
    const ffmpeg = await ensureFfmpeg()
    if (controller.signal.aborted) return 130
    args.push('--ffmpeg-location', ffmpeg, ...electronNodeRuntimeArgs(), '--remote-components', 'ejs:github')
    const inspecting = options.listFormats || options.getUrl
    if (!inspecting) args.push('--no-simulate', ...MEDIA_PROGRESS_ARGS)
    args.push('--', ...urls)
    return await new Promise<number>((done, reject) => {
      const child = spawn(executable, args, { windowsHide: true, env: electronNodeRuntimeEnv(), stdio: ['ignore', 'pipe', 'pipe'] })
      const stop = (): void => { status.set('Pausing your download…'); killTree(child) }
      controller.signal.addEventListener('abort', stop, { once: true })
      if (controller.signal.aborted) stop()
      const progress = new MediaProgress()
      status.progress([progress.current])
      let failed = false
      const receive = (raw: string): void => {
        const line = cleanText(raw)
        const event = progress.receive(line)
        if (event?.kind === 'progress') status.progress([progress.current])
        else if (event?.kind === 'done') {
          // The merged file's size is only known once it exists; yt-dlp's own
          // filesize field describes the streams, not the result.
          let size: number | null = null
          try { size = statSync(event.path).size } catch {}
          status.saved(event.path, `Saved ${basename(event.path)}${size ? ` · ${formatBytes(size)}` : ''}`)
        } else if (line.startsWith('ERROR:')) {
          failed = true
          status.error(`Could not download: ${friendlyError(line)}`)
        } else if (inspecting || (options.verbose && line)) status.info(line)
      }
      const stdout = createInterface({ input: child.stdout })
      const stderr = createInterface({ input: child.stderr })
      stdout.on('line', receive); stderr.on('line', receive)
      const cleanup = (): void => { controller.signal.removeEventListener('abort', stop); stdout.close(); stderr.close() }
      child.once('error', error => { cleanup(); reject(error) })
      child.once('close', code => {
        cleanup()
        status.progress([])
        if (controller.signal.aborted) {
          // The full-screen UI words its own pause note ("Press F5"); a plain run needs this one.
          if (!signal) status.info('Paused. Run the same command again to pick up where it stopped.')
          done(130)
        }
        else {
          // yt-dlp exits non-zero without an ERROR line when, say, it is killed.
          if (code !== 0 && !failed) status.error('Could not download: the downloader stopped unexpectedly.')
          done(code === 0 ? 0 : 1)
        }
      })
    })
  } finally {
    signal?.removeEventListener('abort', abort)
    if (!signal) process.removeListener('SIGINT', abort)
  }
}
</file>

<file path="src/cli/path-setup.ts">
/**
 * Bundle entry the NSIS installer runs (out/main/path-setup.js), with
 * Draco.exe acting as Node via ELECTRON_RUN_AS_NODE:
 *
 *   path-setup.js add    <dir>   - setup: put draco.cmd's folder on PATH
 *   path-setup.js remove <dir>   - uninstall: take it back off
 *
 * The installer delegates instead of editing PATH itself because NSIS strings
 * have a fixed size, and a user PATH longer than that comes back truncated -
 * this way setup, uninstall and the Options toggle all share one tested
 * implementation in `cli-path.ts`.
 *
 * Never fails the install: a PATH problem is reported in the installer's log
 * and the exit code, and the app's own start-up sync gets another go at it.
 */
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import { addCliToPath, removeCliFromPath } from '../main/cli-path.ts'

async function run([action, dir]: string[]): Promise<number> {
  if (!dir || (action !== 'add' && action !== 'remove')) {
    process.stderr.write('usage: path-setup add|remove <dir>\n')
    return 2
  }
  if (action === 'add') {
    // Refuse to point PATH at a folder that would not actually give `draco`.
    if (!existsSync(join(dir, 'draco.cmd'))) {
      process.stderr.write(`draco.cmd not found in ${dir}; PATH left unchanged\n`)
      return 1
    }
    const changed = await addCliToPath(dir)
    process.stdout.write(changed ? `added ${dir} to PATH; draco works in new terminals\n` : `${dir} is already on PATH\n`)
  } else {
    const changed = await removeCliFromPath(dir)
    process.stdout.write(changed ? `removed ${dir} from PATH\n` : `${dir} was not on PATH\n`)
  }
  return 0
}

void run(process.argv.slice(2)).then(
  (code) => process.exit(code),
  (error: unknown) => {
    process.stderr.write(`PATH update failed: ${error instanceof Error ? error.message : String(error)}\n`)
    process.exit(1)
  }
)
</file>

<file path="src/cli/preferences.ts">
import { mkdir, readFile, rename, writeFile } from 'node:fs/promises'
import { dirname } from 'node:path'
import type { FormatSpec } from './args.ts'

export type SavedFormat = Exclude<FormatSpec, { kind: 'index' }>
export interface Preferences { format?: SavedFormat; dir?: string }

export function savedFormat(value: unknown): SavedFormat | undefined {
  if (!value || typeof value !== 'object') return undefined
  const f = value as Record<string, unknown>
  if (f.kind === 'best' || f.kind === 'worst' || f.kind === 'bestaudio') return { kind: f.kind }
  if (f.kind === 'height' && Number.isSafeInteger(f.height) && Number(f.height) > 0) {
    return { kind: 'height', height: Number(f.height) }
  }
  return undefined
}

export async function readPreferences(path: string): Promise<Preferences> {
  try {
    const value = JSON.parse(await readFile(path, 'utf8'))
    return {
      format: savedFormat(value?.format),
      dir: typeof value?.dir === 'string' && value.dir.trim() && !/[\x00-\x1f]/.test(value.dir) ? value.dir : undefined
    }
  } catch (error) {
    if (error instanceof SyntaxError || (error as NodeJS.ErrnoException).code === 'ENOENT') return {}
    throw error
  }
}

export async function writePreferences(path: string, value: Preferences): Promise<void> {
  await mkdir(dirname(path), { recursive: true })
  const temporary = `${path}.${process.pid}.tmp`
  await writeFile(temporary, JSON.stringify(value, null, 2) + '\n', { mode: 0o600 })
  await rename(temporary, path)
}

export function formatLabel(format: FormatSpec): string {
  switch (format.kind) {
    case 'height': return `${format.height}p`
    case 'bestaudio': return 'Audio only'
    case 'worst': return 'Smallest'
    case 'index': return `Format #${format.index}`
    default: return 'Best available'
  }
}
</file>

<file path="src/cli/progress.ts">
import { ellipsize, pad, richGlyphs, RICH_GLYPHS, SAFE_GLYPHS, width, type Glyphs } from './text.ts'

/**
 * One download as the screen shows it - the same shape whether the bytes come
 * from Draco's own engine or from yt-dlp, so both paths draw the same card.
 *
 * Structured on purpose: the old pipeline pre-rendered strings and the UI then
 * regex-patched bars into them. Numbers in, layout decided at draw time, means
 * the bar can stretch to whatever width the terminal has.
 */
export interface Transfer {
  id: string
  title: string
  /** waiting: queued · preparing: before any bytes · downloading · finishing: merge/embed */
  phase: 'waiting' | 'preparing' | 'downloading' | 'finishing'
  /** What is happening right now in plain words: "Video", "Merging video and audio". */
  step: string | null
  /** 1-based part of a multi-part download (video, then audio). */
  part: number | null
  parts: number | null
  received: number | null
  total: number | null
  /** Bytes per second. */
  speed: number | null
  /** Seconds left. */
  eta: number | null
}

export function transfer(id: string, title: string, phase: Transfer['phase'], extra: Partial<Transfer> = {}): Transfer {
  return { id, title, phase, step: null, part: null, parts: null, received: null, total: null, speed: null, eta: null, ...extra }
}

/**
 * Colour hooks (identity functions when colour is off, so layout code never
 * branches on it) plus the symbol set the console's font can draw.
 */
export interface Painter {
  g: Glyphs
  accent: (s: string) => string
  dim: (s: string) => string
  faint: (s: string) => string
  track: (s: string) => string
  strong: (s: string) => string
  good: (s: string) => string
  bad: (s: string) => string
}

export function painter(color: boolean, rich: boolean = richGlyphs()): Painter {
  const paint = (code: string) => (s: string): string => (color && s ? `\x1b[${code}m${s}\x1b[0m` : s)
  return {
    g: rich ? RICH_GLYPHS : SAFE_GLYPHS,
    accent: paint('38;5;214'),
    dim: paint('38;5;245'),
    faint: paint('38;5;240'),
    track: paint('38;5;237'),
    strong: paint('1;97'),
    good: paint('38;5;114'),
    bad: paint('38;5;203')
  }
}

/* ------------------------------------------------------------------ */
/* Human units                                                          */
/* ------------------------------------------------------------------ */

/** "58.8 MB". Binary multiples with the familiar labels, as Explorer shows them. */
export function formatBytes(n: number | null | undefined): string {
  if (n === null || n === undefined || !Number.isFinite(n) || n < 0) return '?'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let value = n, unit = 0
  while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit++ }
  return `${value.toFixed(unit === 0 || value >= 100 ? 0 : 1)} ${units[unit]}`
}

/** "8s", "2m 08s", "1h 04m": reads at a glance, unlike 00:02:08. */
export function formatDuration(seconds: number | null | undefined): string | null {
  if (seconds === null || seconds === undefined || !Number.isFinite(seconds) || seconds < 0) return null
  const s = Math.round(seconds)
  if (s < 60) return `${s}s`
  if (s < 3600) return `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s`
  return `${Math.floor(s / 3600)}h ${String(Math.floor((s % 3600) / 60)).padStart(2, '0')}m`
}

export function fractionOf(t: Transfer): number | null {
  if (t.phase !== 'downloading' || !t.total || t.received === null) return null
  return Math.max(0, Math.min(1, t.received / t.total))
}

/* ------------------------------------------------------------------ */
/* The bar                                                              */
/* ------------------------------------------------------------------ */

// Eighth blocks give the bar sub-cell precision, so it creeps smoothly instead
// of jumping a whole column at a time on a narrow terminal.
const EIGHTHS = ['', '▏', '▎', '▍', '▌', '▋', '▊', '▉']

/**
 * A bar exactly `size` columns wide. `null` is indeterminate: a short glow
 * sweeping back and forth, driven by the wall clock so every redraw advances
 * it without the caller keeping animation state.
 */
export function progressBar(fraction: number | null, size: number, p: Painter, now = Date.now()): string {
  size = Math.max(1, size)
  if (fraction === null || !Number.isFinite(fraction)) {
    const glow = Math.max(1, Math.min(8, Math.floor(size / 5)))
    // `span` is how far the glow can travel; 0 on a bar no wider than the glow.
    const span = size - glow
    const step = span > 0 ? Math.floor(now / 90) % (span * 2) : 0
    const at = step < span ? step : span * 2 - step
    return p.track('░'.repeat(at)) + p.accent('█'.repeat(glow)) + p.track('░'.repeat(Math.max(0, size - at - glow)))
  }
  const exact = Math.max(0, Math.min(1, fraction)) * size
  const full = Math.floor(exact)
  const partial = full < size && p.g.smooth ? EIGHTHS[Math.floor((exact - full) * 8)] : ''
  const track = size - full - (partial ? 1 : 0)
  return p.accent('█'.repeat(full) + partial) + p.track('░'.repeat(track))
}

function percentLabel(fraction: number): string {
  const value = fraction * 100
  return `${value < 10 && value > 0 ? value.toFixed(1) : Math.floor(value)}%`
}

/**
 * A download as three lines, every one exactly fitted to `columns`:
 *
 *   ↓ The International Archives: Gyro Diffusal          Video · 1 of 2
 *   ██████████████████▌░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░  34%
 *   20.1 MB of 58.8 MB · 4.5 MB/s · 8s left
 */
export function transferLines(t: Transfer, columns: number, p: Painter, now = Date.now()): string[] {
  const w = Math.max(8, columns)
  const icon = t.phase === 'finishing' ? p.g.finish : t.phase === 'waiting' ? p.g.wait : p.g.down
  const where = [t.step, t.parts && t.parts > 1 && t.part ? `${t.part} of ${t.parts}` : null].filter(Boolean).join(' · ')
  const tag = where || { waiting: 'Waiting', preparing: 'Preparing', downloading: 'Downloading', finishing: 'Finishing' }[t.phase]
  const tagWidth = width(tag) < w / 3 ? width(tag) : 0
  const titleWidth = Math.max(1, w - 2 - (tagWidth ? tagWidth + 2 : 0))
  const head = p.accent(icon) + ' ' + p.strong(pad(ellipsize(t.title, titleWidth), titleWidth)) +
    (tagWidth ? '  ' + p.dim(tag) : '')

  const fraction = fractionOf(t)
  const label = fraction === null ? '' : percentLabel(fraction)
  const barWidth = Math.max(1, w - 6)
  const bar = progressBar(fraction, barWidth, p, now) + ' ' + p.strong(label.padStart(5))

  let detail: string
  if (t.phase === 'downloading') {
    const amount = t.total ? `${formatBytes(t.received)} of ${formatBytes(t.total)}` : t.received ? `${formatBytes(t.received)} so far` : 'Starting'
    const speed = t.speed ? `${formatBytes(t.speed)}/s` : null
    const left = formatDuration(t.eta)
    detail = [amount, speed, left ? `${left} left` : t.received ? 'estimating time…' : null].filter(Boolean).join(' · ')
  } else if (t.phase === 'finishing') detail = `${t.step ?? 'Finishing your file'}…`
  else if (t.phase === 'waiting') detail = 'Waiting for a free slot…'
  else detail = t.step ? `${t.step}…` : 'Getting ready…'
  return [head, bar, p.dim(ellipsize(detail, w))]
}

/* ------------------------------------------------------------------ */
/* Words people understand                                               */
/* ------------------------------------------------------------------ */

/** yt-dlp postprocessor keys (`pp_key()`) in plain words. */
const STEPS: Record<string, string> = {
  Merger: 'Merging video and audio',
  Metadata: 'Saving title and chapters',
  EmbedThumbnail: 'Adding cover art',
  ThumbnailsConvertor: 'Preparing cover art',
  EmbedSubtitle: 'Adding subtitles',
  SubtitlesConvertor: 'Preparing subtitles',
  ExtractAudio: 'Extracting audio',
  VideoRemuxer: 'Changing the container',
  VideoConvertor: 'Converting video',
  ModifyChapters: 'Updating chapters',
  SponsorBlock: 'Checking SponsorBlock',
  SplitChapters: 'Splitting chapters',
  MoveFiles: 'Moving into place'
}

export function stepName(postprocessor: string): string {
  if (STEPS[postprocessor]) return STEPS[postprocessor]
  if (postprocessor.startsWith('Fixup')) return 'Tidying up the file'
  return 'Finishing your file'
}

/**
 * Turns an error from yt-dlp, the engine, or the OS into a sentence that says
 * what to do. Unknown errors keep their text, minus the bits only a developer
 * reads (`[youtube] dQw4w9WgXcQ:` prefixes, "please report this issue" tails).
 */
export function friendlyError(raw: string): string {
  const text = raw.replace(/^(?:ERROR|error):\s*/, '').replace(/^\[[\w:.-]+\]\s*(?:[\w-]+:\s*)?/, '').trim()
  const rules: Array<[RegExp, string]> = [
    [/confirm your age|age[- ]restricted|inappropriate for some users/i, 'This video is age-restricted. Add --cookies-from-browser firefox to draco.cfg to use your signed-in browser.'],
    [/sign in to confirm|not a bot|login required|requires authentication|use --cookies/i, 'The site wants you signed in. Add --cookies-from-browser firefox (or your browser) to draco.cfg.'],
    [/could not (?:copy|find|decrypt).*cookie|cookies? database|failed to (?:load|decrypt) cookies/i, 'Could not read your browser cookies. Close the browser and try again.'],
    [/private video/i, 'This video is private.'],
    [/members[- ]only|join this channel/i, 'This video is for channel members only.'],
    [/premieres in|live event will begin|this live event/i, 'This video has not started yet.'],
    [/video unavailable|has been removed|no longer available|not available in your country|blocked it in your country/i, 'This video is not available - removed, private, or blocked where you are.'],
    [/unsupported url|no video formats found|unable to extract/i, 'Draco could not find anything to download at this link.'],
    [/requested format (?:is )?not available|format not available/i, 'That quality is not available for this video. Choose another one in F2 Settings.'],
    [/HTTP Error 404|\b404\b/i, 'Nothing was found at this link (404).'],
    [/HTTP Error 403|\b403\b|forbidden/i, 'The site refused the download (403). Try again in a moment.'],
    [/HTTP Error 429|too many requests/i, 'The site is limiting downloads right now. Wait a few minutes and try again.'],
    [/ENOTFOUND|EAI_AGAIN|getaddrinfo|name or service not known|nodename nor servname/i, 'Could not reach the site. Check your internet connection.'],
    [/ETIMEDOUT|timed out|ECONNRESET|ECONNREFUSED|connection (?:reset|refused|aborted)/i, 'The connection dropped. Check your internet connection and try again.'],
    [/ENOSPC|no space left|not enough (?:disk )?space/i, 'Your disk is full. Free up some space and try again.'],
    [/EACCES|EPERM|permission denied|access is denied/i, 'Draco cannot save to this folder. Choose another one in F2 Settings.'],
    [/ffmpeg (?:is )?not (?:found|installed)/i, 'A required component (ffmpeg) is missing. Reinstall Draco.']
  ]
  for (const [pattern, message] of rules) if (pattern.test(text)) return message
  return text.replace(/;?\s*please report this issue.*$/i, '').replace(/\s*\(caused by .*\)$/i, '').trim() || 'Something went wrong.'
}
</file>

