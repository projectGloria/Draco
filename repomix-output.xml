  it('lists every track page once, in album order', () => {
    deepStrictEqual(album.trackUrls, [
      `${ALBUM_URL}/01.%2520Main%2520Theme.mp3`,
      `${ALBUM_URL}/02.%2520Prologue.mp3`
    ])
  })

  it('leaves the album sub-pages and neighbouring albums out', () => {
