import { strictEqual } from 'node:assert/strict'
import { describe, it } from 'node:test'
import { effectiveSpeedLimit, parseClock, withinWindow } from '../src/main/engine/limit-window.ts'

/** 2024-01-03, a Wednesday. Only the clock matters here. */
function at(hours: number, minutes = 0): Date {
  return new Date(2024, 0, 3, hours, minutes, 0, 0)
}

const KB = 1024

describe('parseClock', () => {
  it('reads a time as minutes since midnight', () => {
    strictEqual(parseClock('00:00'), 0)
    strictEqual(parseClock('9:30'), 570)
    strictEqual(parseClock('23:59'), 1439)
  })

  it('has no answer for something that is not a time', () => {
    strictEqual(parseClock('24:00'), null)
    strictEqual(parseClock('10:60'), null)
    strictEqual(parseClock('noon'), null)
    strictEqual(parseClock(null), null)
  })
})

describe('withinWindow', () => {
  it('opens on the start minute and closes on the stop minute', () => {
    strictEqual(withinWindow('09:00', '17:00', at(8, 59)), false)
    strictEqual(withinWindow('09:00', '17:00', at(9, 0)), true)
    strictEqual(withinWindow('09:00', '17:00', at(16, 59)), true)
    strictEqual(withinWindow('09:00', '17:00', at(17, 0)), false)
  })

  it('carries a window across midnight', () => {
    strictEqual(withinWindow('23:00', '06:00', at(22, 59)), false)
    strictEqual(withinWindow('23:00', '06:00', at(23, 30)), true)
    strictEqual(withinWindow('23:00', '06:00', at(0, 0)), true)
    strictEqual(withinWindow('23:00', '06:00', at(5, 59)), true)
    strictEqual(withinWindow('23:00', '06:00', at(6, 0)), false)
  })

  it('reads an empty window as never, not always', () => {
    // An accidental 00:00-00:00 must not throttle the app around the clock.
    strictEqual(withinWindow('12:00', '12:00', at(12, 0)), false)
    strictEqual(withinWindow('12:00', '12:00', at(3, 0)), false)
  })

  it('is closed when the times are not times', () => {
    strictEqual(withinWindow('nine', '17:00', at(12)), false)
    strictEqual(withinWindow('09:00', undefined, at(12)), false)
  })
})

describe('effectiveSpeedLimit', () => {
  const scheduled = { startTime: '09:00', stopTime: '17:00', bytesPerSecond: 200 * KB }

  it('is the ordinary limit with nothing scheduled', () => {
    strictEqual(effectiveSpeedLimit({ speedLimit: 500 * KB }, at(12)), 500 * KB)
    strictEqual(effectiveSpeedLimit({ speedLimit: null }, at(12)), null)
  })

  it('replaces the ordinary limit while the window is open', () => {
    // Two numbers that both applied would need a rule for which wins; the plain
    // reading of "200 KB/s between 9 and 5" is that it *is* the limit then.
    strictEqual(effectiveSpeedLimit({ speedLimit: 500 * KB, scheduledLimit: scheduled }, at(12)), 200 * KB)
    strictEqual(effectiveSpeedLimit({ speedLimit: null, scheduledLimit: scheduled }, at(12)), 200 * KB)
  })

  it('hands back the ordinary limit once the window closes', () => {
    strictEqual(effectiveSpeedLimit({ speedLimit: 500 * KB, scheduledLimit: scheduled }, at(20)), 500 * KB)
    strictEqual(effectiveSpeedLimit({ speedLimit: null, scheduledLimit: scheduled }, at(20)), null)
  })

  it('ignores a scheduled limit of zero, which means no limit at all', () => {
    strictEqual(
      effectiveSpeedLimit({ speedLimit: 500 * KB, scheduledLimit: { ...scheduled, bytesPerSecond: 0 } }, at(12)),
      500 * KB
    )
  })
})
</file>

<file path="tests/manager-pause-failure.test.ts">
import { rejects, strictEqual } from 'node:assert/strict'
import { it } from 'node:test'
import { tmpdir } from 'node:os'
import { createTask } from '../src/main/engine/create.ts'
import { DownloadManager, type EngineSettings } from '../src/main/engine/manager.ts'
import type { Runner } from '../src/main/engine/runner.ts'

const settings: EngineSettings = {
  maxConcurrentTasks: 2, maxConnectionsPerTask: 1, minSplitSize: 1024,
  retryLimit: 0, timeoutMs: 1000, speedLimit: null, proxyUrl: null,
  hostConnectionLimits: [], quotaBytes: null, quotaWindowMinutes: 60,
  antivirusProgram: null, antivirusArgs: [], antivirusTimeoutSeconds: 1
}

function fixture() {
  const manager = new DownloadManager({
    getSettings: () => settings, onTasks() {}, onProgress() {}
  })
  const tasks = [0, 1].map((index) => manager.add(createTask({
    url: `https://example.test/${index}.bin`, dir: tmpdir(), filename: `${index}.bin`, kind: 'file'
  }), false))
  const runners = (manager as unknown as { runners: Map<string, Runner> }).runners
  return { manager, tasks, runners }
}

it('waits for all pauses and refuses removal if one runner cannot stop', async () => {
  const { manager, tasks, runners } = fixture()
  let otherStopped = false
  let fail = true
  runners.set(tasks[0].id, {
    task: tasks[0], running: true, async start() {},
    async pause() { if (fail) throw new Error('journal flush failed') },
    tick() {}, async resetForRestart() { return false }
  })
  runners.set(tasks[1].id, {
    task: tasks[1], running: true, async start() {},
    async pause() { otherStopped = true },
    tick() {}, async resetForRestart() { return false }
  })

  await rejects(manager.pause(tasks.map((task) => task.id)), /Could not pause every selected download/)
  strictEqual(otherStopped, true)
  await rejects(manager.remove([tasks[0].id], true), /Could not pause every selected download/)
  strictEqual(manager.get(tasks[0].id)?.id, tasks[0].id)
  fail = false
  await manager.shutdown()
})

it('blocks shutdown if any runner fails to pause', async () => {
  const { manager, tasks, runners } = fixture()
  let otherStopped = false
  runners.set(tasks[0].id, {
    task: tasks[0], running: true, async start() {},
    async pause() { throw new Error('still writing') },
    tick() {}, async resetForRestart() { return false }
  })
  runners.set(tasks[1].id, {
    task: tasks[1], running: true, async start() {},
    async pause() { otherStopped = true },
    tick() {}, async resetForRestart() { return false }
  })

  await rejects(manager.shutdown(), /Could not pause every download before quitting/)
  strictEqual(otherStopped, true)
})

it('does not restart a task while its removal is waiting for the old runner', async () => {
  const { manager, tasks, runners } = fixture()
  const task = tasks[0]
  task.status = 'downloading'
  let release!: () => void
  const stopping = new Promise<void>((resolve) => { release = resolve })
  let entered!: () => void
  const paused = new Promise<void>((resolve) => { entered = resolve })
  runners.set(task.id, {
    task, running: true, async start() {},
    async pause() {
      task.status = 'paused'
      entered()
      await stopping
      runners.delete(task.id)
      task.status = 'paused'
    },
    tick() {}, async resetForRestart() { return false }
  })
  const removing = manager.remove([task.id], false)
  await paused
  try {
    manager.start([task.id])
    strictEqual(task.status, 'paused', 'a removal must own the task until teardown finishes')
  } finally {
    release()
    await removing
  }
  strictEqual(manager.get(task.id), undefined)
  strictEqual(runners.has(task.id), false)
  await manager.shutdown()
})

it('honors Resume pressed while Pause is still flushing the old runner', async () => {
  const { manager, tasks, runners } = fixture()
  const task = tasks[0]
  task.status = 'downloading'
  let release!: () => void
  const closing = new Promise<void>((resolve) => { release = resolve })
  let entered!: () => void
  const pausing = new Promise<void>((resolve) => { entered = resolve })
  runners.set(task.id, {
    task, running: true, async start() {},
    async pause() {
      task.status = 'paused'
      entered()
      await closing
      task.status = 'paused'
      runners.delete(task.id)
    },
    tick() {}, async resetForRestart() { return false }
  })
  // Keep the next launch queued so this regression makes no network requests.
  ;(manager as unknown as { schedule(): void }).schedule = () => {}
  const stopping = manager.pause([task.id], true)
  await pausing
  manager.start([task.id])
  release()
  await stopping
  strictEqual(task.status, 'queued', 'the settling old runner must not overwrite the later Resume command')
  strictEqual(task.manualPause, false)
  await manager.shutdown()
})
</file>

<file path="tests/media-cancellation.test.ts">
import { rejects, strictEqual } from 'node:assert/strict'
import { createServer } from 'node:http'
import type { AddressInfo } from 'node:net'
import { test } from 'node:test'
import { build } from 'esbuild'
import { loadMediaPlaylist, resolveVariants } from '../src/main/hls/playlist.ts'
import { resolveMpd } from '../src/main/dash/manifest.ts'
import { closeDispatchers } from '../src/main/engine/http.ts'
import { createTask } from '../src/main/engine/create.ts'
import { RateLimiter } from '../src/main/engine/limiter.ts'
import { tmpdir } from 'node:os'
import { createRequire } from 'node:module'

test('playlist and MPD requests abort while their bodies are stalled', async () => {
  let arrived!: () => void
  let arrival = new Promise<void>((resolve) => { arrived = resolve })
  const server = createServer((_request, response) => {
    response.writeHead(200, { 'content-type': 'text/plain' })
    response.write('stalled manifest')
    arrived()
  })
  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/manifest`
  try {
    for (const mode of ['hls', 'mpd']) {
      arrival = new Promise<void>((resolve) => { arrived = resolve })
      const controller = new AbortController()
      const pending = mode === 'hls'
        ? loadMediaPlaylist(url, {}, { signal: controller.signal, timeoutMs: 5000 })
        : resolveMpd(url, {}, 5000, controller.signal)
      const checked = rejects(pending)
      await arrival
      controller.abort()
      await checked
    }
    await rejects(loadMediaPlaylist(url, {}, { timeoutMs: 50 }))
  } finally {
    await closeDispatchers()
    server.closeAllConnections()
    await new Promise<void>((resolve) => server.close(() => resolve()))
  }
})

test('starting an HLS runner need not sample every rendition before selecting quality', async () => {
  let samples = 0
  const server = createServer((request, response) => {
    if (request.url === '/master') response.end('#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000000\nmedia.m3u8\n')
    else { samples++; response.writeHead(500).end() }
  })
  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
  try {
    const variants = await resolveVariants(`http://127.0.0.1:${(server.address() as AddressInfo).port}/master`, {}, { estimateSizes: false })
    strictEqual(variants.length, 1)
    strictEqual(samples, 0)
  } finally {
    await closeDispatchers()
    await new Promise<void>((resolve) => server.close(() => resolve()))
  }
})

test('pausing a composite during file adoption waits for cleanup and starts no HTTP children', async () => {
  const bundle = await build({
    entryPoints: ['src/main/hls/dash.ts'], bundle: true, platform: 'node', format: 'cjs', packages: 'external', write: false,
    define: { 'import.meta.env': '{}' },
    plugins: [{ name: 'media-tools-stub', setup(build) {
      build.onLoad({ filter: /[\\/]ffmpeg\.ts$/ }, () => ({ contents: 'export async function ensureFfmpeg() { throw new Error("unexpected media tool") }', loader: 'js' }))
    } }]
  })
  const bundled = { exports: {} as { DashRunner?: any } }
  new Function('require', 'module', 'exports', bundle.outputFiles[0].text)(createRequire(import.meta.url), bundled, bundled.exports)
  const { DashRunner } = bundled.exports
  const task = createTask({ url: 'https://example.test/video', audioUrl: 'https://example.test/audio', dir: tmpdir(), filename: 'media.mp4' })
  let finished = 0
  const runner = new DashRunner(task, {
    limiter: new RateLimiter(), maxConnections: 2, minSplitSize: 1024, retryLimit: 1,
    timeoutMs: 1000, proxyUrl: null, onUpdate() {}, onFinished() { finished++ }
  })
  let release!: () => void
  const adoption = new Promise<boolean>((resolve) => { release = () => resolve(false) })
  runner.adoptFinishedHalf = () => adoption
  let starts = 0
  runner.videoRunner.start = async () => { starts++ }
  runner.audioRunner.start = async () => { starts++ }
  const started = runner.start()
  let paused = false
  const stop = runner.pause().then(() => { paused = true })
  await new Promise((resolve) => setImmediate(resolve))
  strictEqual(paused, false, 'the parent still has pending work')
  release()
  await Promise.all([started, stop])
  strictEqual(starts, 0)
  strictEqual(finished, 1)
  strictEqual(task.status, 'paused')
})
