        </div>
        <div className="text-[11px] text-faint truncate" title={url}>
          {url}
        </div>
      </div>
    </div>
  )
}

function SaveTo({
  dir,
  onPick
}: {
  dir: string | null
  onPick(next: string | null): void
}): React.ReactElement {
  return (
    <div>
      <label className="label">Save to</label>
