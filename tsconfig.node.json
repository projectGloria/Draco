{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    // The engine imports its siblings with explicit .ts specifiers so that
    // `node tools/dl.ts` can run it directly via type stripping, with no build
    // step. Vite resolves the same specifiers when bundling.
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    // The engine tests import the modules under test with the same explicit
    // `.ts` specifiers the engine uses on itself, so they are typechecked by
    // the same project rather than by one of their own.
    "tests/**/*"
  ]
}
