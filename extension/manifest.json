{
  "manifest_version": 3,
  "name": "Draco Integration",
  "version": "0.1.2",
  "description": "Hands downloads and detected media streams to the Draco download manager.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "storage",
    "webRequest",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Draco",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": ""
}
